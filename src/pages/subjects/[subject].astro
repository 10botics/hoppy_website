---
import RedirectPage from '../../components/RedirectPage.astro';

type Subject = 'mathematics' | 'chemistry' | 'ict' | 'economics';

export function getStaticPaths() {
  const subjects: Subject[] = ['mathematics', 'chemistry', 'ict', 'economics'];
  return subjects.map((subject) => ({
    params: { subject },
    props: { subject },
  }));
}

interface Props {
  subject: Subject;
}

const { subject } = Astro.props as Props;
const destination = `/tc/subjects/${subject}`;
---

<RedirectPage to={destination} />
