---
import RedirectPage from '../../../components/RedirectPage.astro';
import { publishedTeacherGuideChapters } from '../../../data/teacherGuide';
import type { Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return ['en', 'tc'].flatMap((lang) =>
    publishedTeacherGuideChapters.map((chapter) => ({
      params: { lang, chapter: chapter.slug },
    })),
  );
}

const { lang, chapter } = Astro.params as { lang: Lang; chapter: string };
---

<RedirectPage to={`/${lang}/guide/teacher/${chapter}`} />
