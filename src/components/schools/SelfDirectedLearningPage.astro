---
import Layout from '../../layouts/Layout.astro';
import SchoolDemoForm from './SchoolDemoForm.astro';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tc = lang === 'tc';
const prefix = `/${lang}`;
const teacherRoot = lang === 'tc' ? '/images/teacher-guide-tc' : '/images/teacher-guide';
const studentRoot = lang === 'tc' ? '/images/student-guide-tc' : '/images/student-guide';

const copy = tc ? {
  metaTitle: '跨學科 AI 自主學習平台｜讓學習成為學生想做的事｜Hoppy',
  metaDescription: 'Hoppy 跨學科 AI 自主學習平台支援老師派發合適題目，並以自主選題、即時解釋和可見進度，幫助學生建立主動練習的動力。',
  eyebrow: '跨學科 AI 自主學習平台', hero: '讓學習，\n成為學生想做的事',
  heroTagline: '把「再玩一局」的動力，帶進每一次學習。',
  heroBody: 'Hoppy 支援老師按教學需要派發合適題目；學生完成後可即時查看結果和解釋，亦可按自己的需要選擇科目和課題。每次完成都有看得見的進步，幫助學生由完成指定練習，逐步建立主動學習的動力。',
  demo: '預約學校示範', seeHow: '看看動力如何形成', heroCard: '完成練習', heroReward: '獲得 10 XP',
  pathsKicker: '兩條路，同一個學習動力', pathsTitle: '從「要我做」，到「我想繼續」。',
  pathsIntro: '自主學習並不等於減少老師的引導。Hoppy 同時支援老師按教學需要安排合適練習，以及學生按自己的程度和需要主動延伸。',
  assignedLabel: '老師派發', assignedTitle: '讓指定練習更值得完成', assignedBody: '學生在同一個清晰流程完成老師安排的功課，即時查看結果和解釋，並看見自己的進度與 XP。',
  ownLabel: '學生主動', ownTitle: '想學時，隨時找到下一步', ownBody: '學生可以選擇年級、科目和學習單元，建立個人練習，不必等待下一份工作紙或功課。',
  loopKicker: 'HOPPY 的學習動力循環', loopTitle: '每一次回應，都令下一步更容易開始',
  loop: [
    ['01', '容易開始', '選一個科目、課題或短練習，目標清晰而且不遙遠。'],
    ['02', '即時理解', '答題後立即看到結果，需要時展開解釋，不必等待批改。'],
    ['03', '看見進步', '完成練習獲得 XP，完成任務獲得寶石，努力不再無聲消失。'],
    ['04', '想再前進', '下一個課題、目標或挑戰就在眼前，鼓勵學生繼續參與。'],
  ],
  proofKicker: '用真實產品畫面說明', proofTitle: '學習動力不是一句口號',
  proofIntro: 'Hoppy 把自主選擇、即時回饋和可見進步放進同一個學生體驗，讓每一步都有清楚結果。',
  proofItems: [
    ['自己選擇想練習的課題', '按年級、科目和學習單元建立個人練習。', 'choice'],
    ['答完立即知道為甚麼', '即時結果與解釋把錯題變成下一次進步的起點。', 'feedback'],
    ['每次完成都有進步紀錄', '答對題目獲得 XP，讓努力和累積成果立即可見。', 'xp'],
    ['老師派發的功課同樣清晰', '查看期限、完成狀態、最佳成績和各學習單元進度。', 'progress'],
  ],
  competitionKicker: '友善競爭，不是一刀切', competitionTitle: '排行榜可以帶來動力，也由學校決定如何使用',
  competitionBody: '部分學生喜歡與同學一起挑戰；另一些學生更適合專注自己的進步。Hoppy 讓學校和老師按年齡及學生需要，顯示全部排名、只顯示指定領先名次，或完全隱藏排行榜。',
  rankTitle: '可選的友善競爭', rankBody: '功課及課室排行榜可按分數、完成時間或累積表現展示進度。',
  controlTitle: '校本顯示設定', controlBody: '學校可跟隨校本預設、顯示全部、只顯示前 N 名或隱藏全部。',
  guide: '查看排行榜管理指南',
  schoolKicker: '配合校本推展', schoolTitle: '由重點級別或科組開始，再逐步擴展',
  schoolBody: '學校可先選擇一個級別、科組或教師團隊試行，了解學生完成指定練習及自主延伸的情況，再按校本需要推展至更多科目、年級或全校。',
  rollout: [['選定應用場景', '先聚焦一個年級、科目或自主學習計劃。'], ['建立學習常規', '由老師派發合適題目，同時鼓勵學生探索自己想加強的課題。'], ['按成效逐步擴展', '根據完成情況、教師觀察與學生回應規劃下一步。']],
  alignmentKicker: '數字教育與自主學習', alignmentTitle: '支援「人工智能＋課程」的校本實踐',
  alignmentBody: 'Hoppy 支援老師在不同科目製作及派發合適題目，亦讓學生按學習需要自主練習，協助學校逐步推動以學生為本的學、教、評轉變。',
  alignmentPoints: ['跨學科應用', '老師引導與學生自主並行', '由小規模試行逐步推展'],
  fundingNote: '學校可因應校本人工智能教育計劃及採購要求，考慮運用「『智』啟學教」撥款訂閱 Hoppy。',
  relatedKicker: '同一平台，另一個學校需要', relatedTitle: '老師也需要更快製作可用的優質題目',
  relatedBody: '了解 Hoppy 如何為不同學科建立可直接派發或匯出 Word 的完整題目。', relatedAction: '查看 AI 題目製作方案',
  formKicker: '看看學生會怎樣使用', formTitle: '為你的學校示範一個完整學習循環',
  formBody: '告訴我們關注的年級、科目和學習情境。我們會示範老師如何派發練習、學生如何自主選題，以及學校如何控制排行榜和使用安排。',
} : {
  metaTitle: 'Student Motivation and Self-Directed Learning | Hoppy for Schools',
  metaDescription: 'Hoppy uses student choice, immediate explanations, XP, Gems and school-controlled leaderboards to support assigned work and self-directed practice.',
  eyebrow: 'HOPPY FOR SELF-DIRECTED LEARNING', hero: 'Make learning\nsomething students want to do',
  heroTagline: 'Bring the motivation of “one more game” into every learning experience.',
  heroBody: 'Hoppy gives teacher-assigned work immediate feedback and lets students choose subjects and topics for themselves. Visible progress after every quiz helps students move from completing a requirement towards building their own motivation to learn.',
  demo: 'Request a school demo', seeHow: 'See how motivation builds', heroCard: 'Quiz complete', heroReward: '10 XP earned',
  pathsKicker: 'TWO PATHS, ONE LEARNING MOTIVATION', pathsTitle: 'From “I have to” to “I want to continue”.',
  pathsIntro: 'Self-directed learning does not mean removing teacher guidance. Hoppy supports both carefully assigned work and independent practice chosen by students.',
  assignedLabel: 'TEACHER ASSIGNED', assignedTitle: 'Make assigned practice worth completing', assignedBody: 'Students complete teacher-assigned work in one clear flow, see results and explanations immediately, and recognise their progress and XP.',
  ownLabel: 'STUDENT INITIATED', ownTitle: 'Always have a next step when curiosity appears', ownBody: 'Students can choose a grade, subject and learning unit to create personal practice without waiting for another worksheet or assignment.',
  loopKicker: 'THE HOPPY MOTIVATION LOOP', loopTitle: 'Every response makes the next step easier to begin',
  loop: [
    ['01', 'Easy to begin', 'Choose a subject, topic or short quiz with a clear and reachable goal.'],
    ['02', 'Understand immediately', 'See the result after answering and open an explanation without waiting for marking.'],
    ['03', 'See progress', 'Earn XP from quizzes and Gems from missions so effort becomes visible.'],
    ['04', 'Want to move forward', 'The next topic, goal or challenge remains close enough to encourage continued participation.'],
  ],
  proofKicker: 'SEE IT IN THE REAL PRODUCT', proofTitle: 'Learning motivation is more than a slogan',
  proofIntro: 'Hoppy combines student choice, immediate feedback and visible progress in one experience, giving every step a clear outcome.',
  proofItems: [
    ['Choose what to practise', 'Create personal practice by grade, subject and learning unit.', 'choice'],
    ['Understand why immediately', 'Instant results and explanations turn a mistake into the starting point for improvement.', 'feedback'],
    ['Make every completed quiz count', 'Earn XP for correct answers so effort and accumulated progress become visible.', 'xp'],
    ['Keep assigned work clear', 'See deadlines, completion, best score and progress by learning unit.', 'progress'],
  ],
  competitionKicker: 'FRIENDLY COMPETITION, NOT ONE SIZE FITS ALL', competitionTitle: 'Leaderboards can motivate, while schools decide how to use them',
  competitionBody: 'Some students enjoy a shared challenge; others benefit from focusing on personal progress. Hoppy lets schools and teachers show all rankings, show only selected leading positions or hide rankings according to age and student needs.',
  rankTitle: 'Optional friendly competition', rankBody: 'Assignment and classroom leaderboards can show progress by score, completion time or accumulated performance.',
  controlTitle: 'School-controlled visibility', controlBody: 'Follow a school default, show all, show the top N positions or hide all rankings.',
  guide: 'Read the leaderboard management guide',
  schoolKicker: 'START WITH ONE STUDENT GROUP', schoolTitle: 'Observe real use, then expand with confidence',
  schoolBody: 'Begin with one grade, department or teacher team. Observe how students complete assigned practice and create their own quizzes, then expand to more subjects, levels or the whole school according to real needs.',
  rollout: [['Choose a setting', 'Focus on one grade, subject or self-directed-learning initiative.'], ['Build a routine', 'Teachers assign practice while students explore topics they want to strengthen.'], ['Expand from evidence', 'Use completion, teacher observation and student response to plan the next step.']],
  alignmentKicker: 'DIGITAL EDUCATION AND SELF-DIRECTED LEARNING', alignmentTitle: 'Support school-based “AI + Curriculum” implementation',
  alignmentBody: 'Hoppy helps teachers create and assign suitable questions across subjects while students practise according to their learning needs, supporting a gradual shift towards student-centred learning, teaching and assessment.',
  alignmentPoints: ['Cross-subject application', 'Teacher guidance alongside student agency', 'Start with a focused rollout and expand gradually'],
  fundingNote: 'Subject to the school’s AI education plan and procurement requirements, eligible schools may consider using the “Empowering Learning and Teaching with AI” grant to subscribe to Hoppy.',
  relatedKicker: 'ANOTHER SCHOOL NEED, ON THE SAME PLATFORM', relatedTitle: 'Teachers also need faster access to high-quality, usable questions',
  relatedBody: 'See how Hoppy creates complete questions across subjects, ready to assign or export to editable Word.', relatedAction: 'Explore AI question creation',
  formKicker: 'SEE HOW STUDENTS WOULD USE IT', formTitle: 'Let us demonstrate a complete learning loop for your school',
  formBody: 'Tell us the grades, subjects and learning context you care about. We will show teacher assignment, student-selected practice, and school control of rankings and rollout.',
};

const proofImages: Record<string, string> = {
  choice: `${teacherRoot}/chapter-1/select-learning-units.jpeg`, feedback: `${teacherRoot}/chapter-3/explanation-open.png`,
  xp: `${studentRoot}/chapter-3/xp-award.png`, progress: `${studentRoot}/chapter-5/assignment-progress.png`,
};
---

<Layout lang={lang} title={copy.metaTitle} description={copy.metaDescription}>
  <main class="sdl-page">
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-copy"><span class="kicker">{copy.eyebrow}</span><h1>{copy.hero.split('\n').map((line, index, lines) => <span>{line}{index < lines.length - 1 ? ' ' : ''}</span>)}</h1><p class="hero-tagline">{copy.heroTagline}</p><p class="hero-body">{copy.heroBody}</p><div class="hero-actions"><a class="button primary" href="#school-demo">{copy.demo}</a><a class="button secondary" href="#motivation-loop">{copy.seeHow}</a></div></div>
        <div class="hero-visual" aria-label={tc ? 'Hoppy 學習動力畫面' : 'Hoppy learning motivation screens'}>
          <div class="phone phone-main"><img src={`${studentRoot}/chapter-3/xp-award.png`} alt={copy.heroReward} /></div>
          <div class="phone phone-side"><img src={`${teacherRoot}/chapter-1/select-learning-units.jpeg`} alt={tc ? '學生選擇科目及學習單元' : 'Student choosing a subject and learning units'} /></div>
          <div class="reward-card"><span>{copy.heroCard}</span><strong>{copy.heroReward}</strong></div>
        </div>
      </div>
    </section>

    <section class="section paths-section"><div class="section-heading"><span class="kicker">{copy.pathsKicker}</span><h2>{copy.pathsTitle}</h2><p>{copy.pathsIntro}</p></div><div class="path-grid">
      <article class="path-card assigned"><span>{copy.assignedLabel}</span><h3>{copy.assignedTitle}</h3><p>{copy.assignedBody}</p><div class="path-image"><img src={`${studentRoot}/chapter-5/assignment-progress.png`} alt={copy.assignedTitle} loading="lazy" /></div></article>
      <article class="path-card initiated"><span>{copy.ownLabel}</span><h3>{copy.ownTitle}</h3><p>{copy.ownBody}</p><div class="path-image"><img src={`${teacherRoot}/chapter-1/select-learning-units.jpeg`} alt={copy.ownTitle} loading="lazy" /></div></article>
    </div></section>

    <section id="motivation-loop" class="loop-section"><div class="section"><div class="section-heading light"><span class="kicker">{copy.loopKicker}</span><h2>{copy.loopTitle}</h2></div><div class="loop-grid">{copy.loop.map(([number,title,body]) => <article><span>{number}</span><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>

    <section class="section proof-section"><div class="section-heading"><span class="kicker">{copy.proofKicker}</span><h2>{copy.proofTitle}</h2><p>{copy.proofIntro}</p></div><div class="proof-grid">{copy.proofItems.map(([title,body,key]) => <article><div class="proof-image"><img src={proofImages[key]} alt={title} loading="lazy" /></div><div><h3>{title}</h3><p>{body}</p></div></article>)}</div></section>

    <section class="competition-section"><div class="section competition-inner"><div class="competition-copy"><span class="kicker">{copy.competitionKicker}</span><h2>{copy.competitionTitle}</h2><p>{copy.competitionBody}</p><a class="text-link" href={`${prefix}/guide/teacher/chapter-7`}>{copy.guide} →</a></div><div class="competition-cards">
      <article><img src={`${teacherRoot}/chapter-7/assignment-leaderboard.png`} alt={copy.rankTitle} loading="lazy" /><h3>{copy.rankTitle}</h3><p>{copy.rankBody}</p></article>
      <article><img src={`${teacherRoot}/chapter-7/leaderboard-visibility.png`} alt={copy.controlTitle} loading="lazy" /><h3>{copy.controlTitle}</h3><p>{copy.controlBody}</p></article>
    </div></div></section>

    <section class="section school-section"><div class="section-heading"><span class="kicker">{copy.schoolKicker}</span><h2>{copy.schoolTitle}</h2><p>{copy.schoolBody}</p></div><div class="rollout-grid">{copy.rollout.map(([title,body],index) => <article><span>0{index+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section>

    <section class="alignment-section"><div class="alignment-inner"><div><span class="kicker">{copy.alignmentKicker}</span><h2>{copy.alignmentTitle}</h2><p>{copy.alignmentBody}</p></div><div class="alignment-details"><ul>{copy.alignmentPoints.map((point) => <li>{point}</li>)}</ul><p class="funding-note">{copy.fundingNote}</p></div></div></section>

    <section class="related-section"><div><span class="kicker">{copy.relatedKicker}</span><h2>{copy.relatedTitle}</h2><p>{copy.relatedBody}</p></div><a class="button secondary" href={`${prefix}/schools/ai-question-creation`}>{copy.relatedAction} →</a></section>

    <section id="school-demo" class="form-section"><div class="section form-inner"><div class="form-intro"><span class="kicker">{copy.formKicker}</span><h2>{copy.formTitle}</h2><p>{copy.formBody}</p></div><div class="form-card"><SchoolDemoForm lang={lang} /></div></div></section>
  </main>
</Layout>

<style>
  .sdl-page { background:#fff; color:#183247; }.section{max-width:1180px;margin:0 auto;padding:6rem 2rem}.kicker{display:inline-block;color:#178fb9;font-size:.76rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}.hero{overflow:hidden;background:radial-gradient(circle at 82% 22%,rgba(255,217,102,.38),transparent 28%),linear-gradient(145deg,#f4fbfe 0%,#fff 55%,#eefbe8 100%)}.hero-inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(420px,.9fr);align-items:center;gap:4.5rem;max-width:1240px;min-height:700px;margin:0 auto;padding:5.5rem 2rem 6rem}.hero h1{margin:1rem 0 1.25rem;font-size:clamp(3rem,5vw,4.8rem);line-height:1.04;letter-spacing:-.045em}.hero h1 span{display:block;white-space:nowrap}.hero-tagline{color:#1682a8;font-size:clamp(1.18rem,2vw,1.55rem);font-weight:800}.hero-body{max-width:670px;margin-top:1rem;color:#4e6879;font-size:1.03rem}.hero-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2rem}.button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;border-radius:999px;padding:.8rem 1.45rem;text-decoration:none;font-weight:800;transition:transform .2s,box-shadow .2s}.button:hover{transform:translateY(-2px)}.primary{background:#183247;color:#fff;box-shadow:0 12px 28px rgba(24,50,71,.18)}.secondary{border:1px solid #bfd4df;background:rgba(255,255,255,.86);color:#183247}.hero-visual{position:relative;min-height:540px}.phone{position:absolute;overflow:hidden;border:10px solid #fff;border-radius:34px;background:#fff;box-shadow:0 28px 65px rgba(24,50,71,.18)}.phone img{width:100%;height:100%;object-fit:cover;object-position:top}.phone-main{top:5px;right:50px;width:300px;height:515px;transform:rotate(3deg)}.phone-side{bottom:5px;left:0;width:225px;height:380px;transform:rotate(-5deg)}.reward-card{position:absolute;right:0;bottom:55px;display:flex;flex-direction:column;border-radius:18px;padding:1rem 1.25rem;background:#ffd966;box-shadow:0 14px 28px rgba(108,82,0,.18)}.reward-card span{font-size:.72rem;fo