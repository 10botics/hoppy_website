---
import Layout from '../../layouts/Layout.astro';
import SchoolDemoForm from './SchoolDemoForm.astro';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tc = lang === 'tc';
const prefix = `/${lang}`;
const teacherRoot = tc ? '/images/teacher-guide-tc' : '/images/teacher-guide';
const studentRoot = tc ? '/images/student-guide-tc' : '/images/student-guide';

const copy = tc ? {
  title: 'Hoppy 學校方案｜AI 出題與跨學科自主學習',
  description: 'Hoppy 讓每位老師都能運用 AI 製作可用題目，並支援學生跨學科自主練習。學校可由個別科組或級別開始，逐步推展。',
  eyebrow: 'HOPPY 學校方案', hero: '一個平台，連接老師出題與學生學習',
  intro: 'Hoppy 同時支援老師製作及派發合適題目，亦讓學生按自己的程度和需要主動練習。由一個科組、級別或教師團隊開始，再按校本需要逐步擴展。',
  cta: '預約學校示範', explore: '了解兩個應用方向',
  sectionKicker: '兩個互相連接的應用方向', sectionTitle: '由老師備課，到學生持續學習',
  sectionBody: '不是兩套分開的工具。老師製作的題目可以直接派發，學生亦可在同一平台自主建立更多練習。',
  questionLabel: '給老師', questionTitle: '每一科的題目，都同樣出色',
  questionBody: '把課題或教材變成完整、可直接使用的題目，涵蓋不同學科，減省準備和格式整理時間。',
  questionPoints: ['支援全校不同學科', '題目可編輯、直接派發或匯出 Word', '老師保留檢視與調整空間'], questionAction: '了解 AI 題目製作',
  learningLabel: '給學生', learningTitle: '讓學習，成為學生想做的事',
  learningBody: '以自主選題、即時解釋和可見進度，幫助學生投入指定練習，並建立主動延伸學習的動力。',
  learningPoints: ['老師派發與學生自主並行', '完成後即時查看結果和解釋', 'XP、任務及可選的友善競爭'], learningAction: '了解 AI 自主學習',
  schoolKicker: '適合校本推展', schoolTitle: '先解決一個需要，再逐步連接全校',
  schoolBody: '學校不必一開始便全面推行。可先由出題工作較重的科組、重點級別或自主學習計劃開始，觀察實際使用後再擴展。',
  steps: [['01', '選定起點', '教師 AI 出題、學生自主學習，或兩者同步試行。'], ['02', '建立校本做法', '按學科、級別和學生需要設定內容及使用安排。'], ['03', '逐步擴展', '把有效做法推展至更多教師、科目和學生。']],
  alignment: '配合跨學科 AI 應用', alignmentBody: 'Hoppy 支援「人工智能＋課程」及以學生為本的學、教、評轉變。學校可按校本人工智能教育計劃和採購要求，考慮運用「『智』啟學教」撥款訂閱。',
  formKicker: '看看 Hoppy 如何配合你的學校', formTitle: '由你正在處理的需要開始',
  formBody: '告訴我們學校關注的科目、級別和應用方向。我們會以實際題目和學生流程示範，而不是只介紹功能。',
} : {
  title: 'Hoppy for Schools | AI Question Creation and Self-Directed Learning',
  description: 'Hoppy helps every teacher create usable questions with AI and supports self-directed learning across subjects. Start with one team or grade and expand gradually.',
  eyebrow: 'HOPPY FOR SCHOOLS', hero: 'One platform connecting teacher question creation with student learning',
  intro: 'Hoppy helps teachers create and assign suitable questions while students practise according to their level and needs. Start with one department, grade or teacher team, then expand according to school priorities.',
  cta: 'Request a school demo', explore: 'Explore the two use cases',
  sectionKicker: 'TWO CONNECTED USE CASES', sectionTitle: 'From teacher preparation to continued student learning',
  sectionBody: 'These are not two separate tools. Teacher-created questions can be assigned directly, while students can create further practice on the same platform.',
  questionLabel: 'FOR TEACHERS', questionTitle: 'Excellent questions for every subject',
  questionBody: 'Turn a topic or teaching material into complete, immediately usable questions across subjects, reducing preparation and formatting time.',
  questionPoints: ['Supports subjects across the whole school', 'Edit, assign directly or export to Word', 'Teachers retain review and adjustment'], questionAction: 'Explore AI question creation',
  learningLabel: 'FOR STUDENTS', learningTitle: 'Make learning something students want to do',
  learningBody: 'Student choice, immediate explanations and visible progress help students engage with assigned work and build motivation to continue independently.',
  learningPoints: ['Teacher-assigned and student-initiated practice', 'Immediate results and explanations', 'XP, missions and optional friendly competition'], learningAction: 'Explore AI self-directed learning',
  schoolKicker: 'BUILT FOR SCHOOL ROLLOUT', schoolTitle: 'Solve one need first, then connect the whole school',
  schoolBody: 'A school does not need to launch everywhere at once. Begin with a department carrying a heavy question-writing workload, a focus grade or a self-directed-learning initiative, then expand from real use.',
  steps: [['01', 'Choose a starting point', 'Teacher AI question creation, student self-directed learning, or both together.'], ['02', 'Establish a school approach', 'Set content and use arrangements around subjects, levels and student needs.'], ['03', 'Expand gradually', 'Extend effective practice to more teachers, subjects and students.']],
  alignment: 'Support cross-subject AI adoption', alignmentBody: 'Hoppy supports “AI + Curriculum” and a student-centred shift in learning, teaching and assessment. Subject to the school plan and procurement requirements, eligible schools may consider using the “Empowering Learning and Teaching with AI” grant.',
  formKicker: 'SEE HOW HOPPY FITS YOUR SCHOOL', formTitle: 'Start with the need you are working on now',
  formBody: 'Tell us the subjects, levels and use cases your school is considering. We will demonstrate real questions and student workflows, not just a list of features.',
};
---

<Layout lang={lang} title={copy.title} description={copy.description}>
  <main class="schools-hub">
    <section class="hero"><div class="hero-inner"><div class="hero-copy"><span class="kicker">{copy.eyebrow}</span><h1>{copy.hero}</h1><p>{copy.intro}</p><div class="actions"><a class="button primary" href="#school-demo">{copy.cta}</a><a class="button secondary" href="#use-cases">{copy.explore}</a></div></div><div class="hero-visual"><div class="screen question"><img src={`${teacherRoot}/chapter-1/select-learning-units.jpeg`} alt={copy.questionTitle} /></div><div class="screen learning"><img src={`${studentRoot}/chapter-3/xp-award.png`} alt={copy.learningTitle} /></div><div class="bridge">AI <span>→</span> {tc ? '題目' : 'questions'} <span>→</span> {tc ? '學習' : 'learning'}</div></div></div></section>

    <section id="use-cases" class="section use-cases"><div class="heading"><span class="kicker">{copy.sectionKicker}</span><h2>{copy.sectionTitle}</h2><p>{copy.sectionBody}</p></div><div class="use-grid">
      <article class="use-card question-card"><div class="card-copy"><span>{copy.questionLabel}</span><h3>{copy.questionTitle}</h3><p>{copy.questionBody}</p><ul>{copy.questionPoints.map((item) => <li>{item}</li>)}</ul><a href={`${prefix}/schools/ai-question-creation`}>{copy.questionAction} →</a></div><div class="evidence-visual subject-collage" aria-label={copy.questionTitle}>
        {['chinese', 'mathematics', 'physics', 'economics'].map((subject) => <div><img src={`/images/schools/ai-quiz-generator/${subject}.png`} alt="" loading="lazy" /></div>)}
      </div></article>
      <article class="use-card learning-card"><div class="card-copy"><span>{copy.learningLabel}</span><h3>{copy.learningTitle}</h3><p>{copy.learningBody}</p><ul>{copy.learningPoints.map((item) => <li>{item}</li>)}</ul><a href={`${prefix}/schools/self-directed-learning`}>{copy.learningAction} →</a></div><div class="evidence-visual journey" aria-label={copy.learningTitle}>
        <div><span>1</span><img src={`${teacherRoot}/chapter-1/select-learning-units.jpeg`} alt="" loading="lazy" /></div><i>→</i><div><span>2</span><img src={`${teacherRoot}/chapter-3/explanation-open.png`} alt="" loading="lazy" /></div><i>→</i><div><span>3</span><img src={`${studentRoot}/chapter-3/xp-award.png`} alt="" loading="lazy" /></div>
      </div></article>
    </div></section>

    <section class="rollout"><div class="section"><div class="heading light"><span class="kicker">{copy.schoolKicker}</span><h2>{copy.schoolTitle}</h2><p>{copy.schoolBody}</p></div><div class="steps">{copy.steps.map(([number,title,body]) => <article><span>{number}</span><h3>{title}</h3><p>{body}</p></article>)}</div><div class="alignment"><strong>{copy.alignment}</strong><p>{copy.alignmentBody}</p></div></div></section>

    <section id="school-demo" class="form-section"><div class="section form-inner"><div class="form-copy"><span class="kicker">{copy.formKicker}</span><h2>{copy.formTitle}</h2><p>{copy.formBody}</p></div><div class="form-card"><SchoolDemoForm lang={lang} /></div></div></section>
  </main>
</Layout>

<style>
  .schools-hub{color:#183247}.section{max-width:1180px;margin:0 auto;padding:6rem 2rem}.kicker{display:inline-block;color:#168bb5;font-size:.76rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}.hero{overflow:hidden;background:radial-gradient(circle at 82% 20%,rgba(255,217,102,.36),transparent 27%),linear-gradient(145deg,#f3fbfe,#fff 56%,#eefbe8)}.hero-inner{display:grid;grid-template-columns:1fr .9fr;align-items:center;gap:4.5rem;max-width:1240px;min-height:680px;margin:0 auto;padding:5.5rem 2rem}.hero h1{max-width:690px;margin:1rem 0 1.35rem;font-size:clamp(3rem,5vw,4.65rem);line-height:1.04;letter-spacing:-.045em}.hero-copy>p{max-width:680px;color:#536d7c;font-size:1.05rem}.actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2rem}.button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;border-radius:999px;padding:.8rem 1.45rem;text-decoration:none;font-weight:800}.primary{background:#183247;color:#fff;box-shadow:0 12px 28px rgba(24,50,71,.18)}.secondary{border:1px solid #bfd4df;background:#fff;color:#183247}.hero-visual{position:relative;min-height:500px}.screen{position:absolute;overflow:hidden;border:9px solid #fff;border-radius:26px;background:#fff;box-shadow:0 25px 55px rgba(24,50,71,.18)}.screen img{width:100%;height:100%;object-fit:cover;object-position:top}.screen.question{top:15px;left:0;width:315px;height:380px;transform:rotate(-4deg)}.screen.learning{right:0;bottom:0;width:275px;height:430px;transform:rotate(4deg)}.bridge{position:absolute;bottom:60px;left:80px;z-index:2;border-radius:999px;padding:.8rem 1.1rem;background:#ffd966;box-shadow:0 12px 24px rgba(111,83,0,.18);font-size:.82rem;font-weight:850}.bridge span{color:#158cb6}.heading{max-width:820px;margin-bottom:2.5rem}.heading h2{margin:.7rem 0 1rem;font-size:clamp(2.2rem,4vw,3.5rem);letter-spacing:-.035em}.heading p{color:#587080;font-size:1.04rem}.use-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch;gap:1.35rem}.use-card{display:flex;min-width:0;overflow:hidden;border:1px solid #dce7ec;border-radius:24px;background:#f6fbfd;flex-direction:column}.learning-card{background:#fffaf0}.card-copy{padding:2rem}.card-copy>span{display:inline-block;border-radius:999px;padding:.35rem .65rem;background:#dff4fb;color:#147fa6;font-size:.7rem;font-weight:850;letter-spacing:.08em}.learning-card .card-copy>span{background:#ffefb7;color:#795b00}.card-copy h3{margin:.9rem 0 .8rem;font-size:clamp(1.7rem,3vw,2.35rem);line-height:1.16}.card-copy p{color:#5d7280}.card-copy ul{display:grid;gap:.55rem;margin:1.2rem 0;padding:0;list-style:none}.card-copy li{position:relative;padding-left:1.4rem;color:#3d5969;font-size:.88rem}.card-copy li:before{position:absolute;left:0;color:#2198bf;content:'✓';font-weight:900}.card-copy a{display:inline-block;margin-top:.3rem;color:#137fa7;font-weight:800;text-decoration:none}.evidence-visual{box-sizing:border-box;height:315px;min-height:315px;max-height:315px;margin-top:auto;overflow:hidden;padding:1.15rem}.subject-collage{display:grid;grid-template-rows:repeat(2,minmax(0,1fr));grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;background:#eaf7fb}.subject-collage div{min-width:0;min-height:0;overflow:hidden;border:5px solid #fff;border-radius:12px;background:#fff;box-shadow:0 8px 18px rgba(24,50,71,.09)}.subject-collage div:nth-child(2),.subject-collage div:nth-child(3){transform:rotate(1.5deg)}.subject-collage div:nth-child(1),.subject-collage div:nth-child(4){transform:rotate(-1.5deg)}.subject-collage img{display:block;width:100%;height:100%;object-fit:cover;object-position:top}.journey{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:.35rem;background:#fff2c8}.journey div{position:relative;box-sizing:border-box;min-width:0;height:245px;overflow:hidden;border:6px solid #fff;border-radius:16px;background:#fff;box-shadow:0 9px 20px rgba(92,71,0,.1)}.journey div:nth-of-type(2){transform:translateY(12px)}.journey span{position:absolute;top:.5rem;left:.5rem;z-index:1;display:grid;width:1.6rem;height:1.6rem;border-radius:50%;place-items:center;background:#183247;color:#fff;font-size:.7rem;font-weight:900}.journey img{display:block;width:100%;height:100%;object-fit:cover;object-position:top}.journey i{color:#c49a13;font-size:1.2rem;font-style:normal;font-weight:900}.rollout{background:#183247}.heading.light h2{color:#fff}.heading.light p{color:#c2d4dd}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.steps article{border:1px solid rgba(255,255,255,.13);border-radius:16px;padding:1.4rem;background:rgba(255,255,255,.05)}.steps span{color:#65cee9;font-size:.76rem;font-weight:900}.steps h3{margin:.65rem 0;color:#fff}.steps p{color:#bed0d9;font-size:.87rem}.alignment{display:grid;grid-template-columns:.4fr 1fr;gap:2rem;margin-top:1.2rem;border-radius:16px;padding:1.5rem;background:#fff}.alignment strong{font-size:1.15rem}.alignment p{color:#587080;font-size:.84rem}.form-section{background:linear-gradient(140deg,#effafe,#fffaf0)}.form-inner{display:grid;grid-template-columns:.8fr 1.2fr;align-items:start;gap:4rem}.form-copy{position:sticky;top:120px}.form-copy h2{margin:.8rem 0 1rem;font-size:clamp(2.1rem,3.7vw,3.2rem)}.form-copy p{color:#587080}.form-card{border:1px solid rgba(24,50,71,.08);border-radius:22px;padding:2rem;background:#fff;box-shadow:0 20px 50px rgba(24,50,71,.1)}
  @media(max-width:980px){.hero-inner,.form-inner{grid-template-columns:1fr}.hero-inner{gap:2rem}.hero-visual{min-height:480px}.form-copy{position:static}}
  @media(max-width:680px){.section{padding:4.5rem 1.2rem}.hero-inner{min-height:auto;padding:4rem 1.2rem}.hero h1{font-size:clamp(2.35rem,11vw,3.2rem)}.hero-visual{min-height:360px}.screen.question{width:210px;height:270px}.screen.learning{width:180px;height:290px}.bridge{bottom:30px;left:25px}.use-grid,.steps{grid-template-columns:1fr}.card-copy{padding:1.5rem}.evidence-visual{height:290px;padding:.85rem}.journey div{height:220px;border-width:4px}.alignment{grid-template-columns:1fr;gap:.7rem}.form-card{padding:1.25rem}}
</style>
