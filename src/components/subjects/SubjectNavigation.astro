---
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  level: 'primary' | 'secondary';
  currentSubject?: string;
}

const { lang, level, currentSubject } = Astro.props as Props;
const t = useTranslations(lang);
const langPrefix = `/${lang}`;
const subjectsByLevel = {
  primary: ['chinese', 'english', 'mathematics', 'general-studies', 'science', 'humanities'],
  secondary: ['chinese', 'english', 'mathematics', 'csd', 'physics', 'chemistry', 'biology', 'ict', 'economics'],
} as const;
const subjects = subjectsByLevel[level];
const schoolLevels = ['primary', 'secondary'] as const;

const getLevelHref = (targetLevel: typeof schoolLevels[number]) => {
  const targetSubjects: readonly string[] = subjectsByLevel[targetLevel];

  if (currentSubject && targetSubjects.includes(currentSubject)) {
    return `${langPrefix}/subjects/${targetLevel}/${currentSubject}`;
  }

  return `${langPrefix}/subjects/${targetLevel}`;
};
---

<nav class="subject-index" aria-label={t('subjects.navigationLabel')}>
  <div class="subject-index-inner">
    <div class="school-level-switcher" aria-label={t('subjects.schoolLevelLabel')}>
      {schoolLevels.map((schoolLevel) => (
        <a
          class="school-level-button"
          href={getLevelHref(schoolLevel)}
          aria-current={schoolLevel === level ? 'page' : undefined}
        >
          {t(`subjects.${schoolLevel}Button`)}
        </a>
      ))}
    </div>
    <div class="subject-links-row">
      <div class="subject-index-links">
        {currentSubject && (
          <a class="all-subjects-link" href={`${langPrefix}/subjects/${level}`}>
            <span aria-hidden="true">←</span>
            {t('subjects.allSubjects')}
          </a>
        )}
        {subjects.map((subject) => (
          <a
            href={`${langPrefix}/subjects/${level}/${subject}`}
            aria-current={subject === currentSubject ? 'page' : undefined}
          >
            {t(`subjects.${subject}.title`)}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<style>
  .subject-index {
    position: sticky;
    top: 72px;
    z-index: 20;
    padding: 0.9rem 2rem;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid #e2e8f0;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
    backdrop-filter: blur(12px);
  }

  .subject-index-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
  }

  .school-level-switcher {
    grid-row: 1;
    justify-self: center;
    display: inline-flex;
    padding: 0.25rem;
    gap: 0.25rem;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    background: #f8fafc;
  }

  .school-level-button {
    min-width: 7rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    color: #475569;
    font-size: 0.85rem;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .school-level-button:hover,
  .school-level-button:focus-visible,
  .school-level-button[aria-current='page'] {
    color: #ffffff;
    background: #0f4c6e;
    outline: none;
  }

  .subject-links-row {
    grid-row: 2;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .subject-index-links a {
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .subject-index-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .subject-index-links a {
    color: #0f4c6e;
    background: #f0f9ff;
    border: 1px solid #bae6fd;
  }

  .subject-index-links a:hover,
  .subject-index-links a:focus-visible,
  .subject-index-links a[aria-current='page'] {
    color: #ffffff;
    background: #0f4c6e;
    border-color: #0f4c6e;
    outline: none;
  }

  @media (max-width: 768px) {
    .subject-index {
      position: static;
      padding: 1rem;
    }

    .subject-index-inner {
      align-items: stretch;
      text-align: center;
    }

    .school-level-switcher {
      justify-self: center;
    }

    .subject-links-row {
      align-items: stretch;
      flex-direction: column;
    }

    .subject-index-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .subject-index-links a:last-child {
      grid-column: 1 / -1;
    }
  }
</style>
