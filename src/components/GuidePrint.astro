---
import {
  publishedTeacherGuideChapters,
  sectionId,
  type GuideChapter,
} from '../data/teacherGuide';
import { publishedTeacherGuideChaptersTc } from '../data/teacherGuideTc';
import { publishedStudentGuideChapters } from '../data/studentGuide';
import { publishedStudentGuideChaptersTc } from '../data/studentGuideTc';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  audience: 'student' | 'teacher';
}

const { lang, audience } = Astro.props;
const isTc = lang === 'tc';
const isStudent = audience === 'student';
const allChapters: GuideChapter[] = isStudent
  ? (isTc ? publishedStudentGuideChaptersTc : publishedStudentGuideChapters)
  : (isTc ? publishedTeacherGuideChaptersTc : publishedTeacherGuideChapters);
const chapters = allChapters.slice(0, -2);
const largeCenteredPhoneSections = new Set(
  ['1.2', '1.4'],
);
const mediumCenteredPhoneSections = new Set(
  isStudent ? [] : ['6.2', '7.4', ...(isTc ? ['8.2'] : [])],
);
const verticallyCenteredSections = new Set(
  isStudent ? ['4.4'] : ['3.6', '7.2', '7.6', ...(!isTc ? ['8.2'] : [])],
);
const deeplyBalancedSections = new Set(
  isStudent ? ['3.5', '6.2'] : ['4.2', '9.2'],
);
const balancedSections = new Set(
  isStudent ? ['1.4', '3.2', '5.2'] : ['1.4', '3.2', '4.3', '5.4', '7.3'],
);
const subtlyBalancedSections = new Set(
  isStudent ? ['1.3'] : ['1.3', '4.4', '7.4', '7.5', '9.3', '9.4'],
);
const assetSrc = (src: string) => `../../../../${src.replace(/^\//, '')}`;

const copy = isTc
  ? {
      language: 'zh-Hant',
      title: isStudent ? 'Hoppy 學生指南' : 'Hoppy 教師指南',
      eyebrow: isStudent ? '玩出學習癮' : '讓教學更高效',
      summary: isStudent
        ? '由建立個人練習、完成課堂功課，到重溫結果及建立跟進練習，一步一步掌握 Hoppy。'
        : '由建立及檢查練習、發佈課堂功課，到查看全班結果及建立跟進練習，一步一步使用 Hoppy 教學。',
      contents: '內容',
      chapter: '章',
      sections: '個主題',
      completion: '完成本章',
      continued: '（續）',
      screenshotPending: '應用程式截圖稍後加入',
      edition: 'PDF 版本 · 2026 年 7 月',
      website: 'hoppy.day',
      downloadApp: '掃描下載 Hoppy 應用程式',
      downloadQrAlt: 'Hoppy 應用程式下載二維碼',
      endingEyebrow: isStudent ? '繼續學習' : '繼續教學',
      endingTitle: isStudent ? '你已準備好使用 Hoppy！' : '你已準備好使用 Hoppy 教學！',
      endingBody: isStudent
        ? '運用 Hoppy 建立練習、完成課堂功課，並透過跟進練習繼續進步。'
        : '運用 Hoppy 建立練習、發佈課堂功課、查看學習成果，並為學生建立跟進練習。',
      endingAction: '掃描二維碼下載 Hoppy 應用程式',
    }
  : {
      language: 'en',
      title: isStudent ? 'Hoppy Student Guide' : 'Hoppy Teacher Guide',
      eyebrow: isStudent ? 'Hop into learning' : 'Teach more efficiently',
      summary: isStudent
        ? 'Create personal practice, complete classroom assignments, review your results, and build follow-up practice—one clear step at a time.'
        : 'Create and check quizzes, publish classroom assignments, review class results, and build follow-up practice—one clear step at a time.',
      contents: 'Contents',
      chapter: 'Chapter',
      sections: 'topics',
      completion: 'Chapter complete',
      continued: '— continued',
      screenshotPending: 'App screenshot to be added',
      edition: 'PDF edition · July 2026',
      website: 'hoppy.day',
      downloadApp: 'Scan to download the Hoppy app',
      downloadQrAlt: 'QR code for downloading the Hoppy app',
      endingEyebrow: isStudent ? 'Keep learning' : 'Keep teaching',
      endingTitle: isStudent ? 'You are ready to use Hoppy!' : 'You are ready to teach with Hoppy!',
      endingBody: isStudent
        ? 'Use Hoppy to create practice, complete classroom assignments, and keep improving with follow-up practice.'
        : 'Use Hoppy to create quizzes, publish classroom assignments, review learning results, and build follow-up practice for your students.',
      endingAction: 'Scan to download the Hoppy app',
    };
---

<!doctype html>
<html lang={copy.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{copy.title}</title>
    <style is:inline>
      :root {
        --ink: #10283f;
        --blue: #26a9df;
        --blue-deep: #078ec8;
        --blue-soft: #eaf8fd;
        --blue-pale: #f6fcff;
        --yellow: #ffd64a;
        --coral: #ff7f74;
        --line: #acdff2;
        --paper: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: #dfe7eb;
      }

      body {
        margin: 0 auto;
        max-width: 210mm;
        color: var(--ink);
        background: var(--paper);
        font-family: Arial, "Noto Sans TC", "Microsoft JhengHei", sans-serif;
        font-size: 10.4pt;
        line-height: 1.55;
      }

      .cover {
        position: relative;
        display: grid;
        min-height: 297mm;
        padding: 20mm 17mm 18mm;
        overflow: hidden;
        break-after: page;
        background:
          linear-gradient(160deg, transparent 0 62%, rgba(255,255,255,.78) 62.2% 100%),
          linear-gradient(145deg, #fff 0 58%, #dff5fc 58.2% 72%, #8edaf2 72.2% 100%);
      }

      .cover::before {
        content: "";
        position: absolute;
        inset: auto -24mm -21mm -18mm;
        height: 86mm;
        border-radius: 48% 58% 0 0;
        background: var(--blue);
        transform: rotate(-3deg);
      }

      .cover-logo {
        width: 53mm;
        height: auto;
      }

      .cover-copy {
        position: relative;
        z-index: 2;
        align-self: center;
        max-width: 118mm;
        padding-bottom: 38mm;
      }

      .cover-rabbit {
        position: absolute;
        z-index: 1;
        right: 16mm;
        bottom: 38mm;
        width: 58mm;
        pointer-events: none;
      }

      .cover-rabbit img {
        display: block;
        width: 100%;
        height: auto;
      }

      .cover-download {
        position: absolute;
        z-index: 3;
        left: 17mm;
        bottom: 35mm;
        display: flex;
        align-items: center;
        gap: 4mm;
        max-width: 90mm;
        color: #fff;
        font-size: 9.5pt;
        font-weight: 800;
        line-height: 1.35;
      }

      .cover-download img {
        display: block;
        width: 27mm;
        height: 27mm;
        padding: 1.5mm;
        border-radius: 2mm;
        background: #fff;
      }

      .cover-eyebrow {
        display: inline-block;
        margin: 0 0 8mm;
        padding: 2.3mm 5mm;
        border-radius: 999px;
        color: #fff;
        background: var(--blue);
        font-size: 10pt;
        font-weight: 800;
        letter-spacing: .04em;
      }

      .cover h1 {
        margin: 0;
        max-width: 150mm;
        font-size: 34pt;
        line-height: 1.08;
        letter-spacing: -.025em;
      }

      .cover-summary {
        max-width: 125mm;
        margin: 8mm 0 0;
        font-size: 14pt;
        line-height: 1.6;
      }

      .cover-meta {
        position: relative;
        z-index: 2;
        align-self: end;
        display: flex;
        justify-content: space-between;
        color: #fff;
        font-size: 9pt;
        font-weight: 700;
      }

      .contents {
        display: flex;
        flex-direction: column;
        min-height: 297mm;
        padding: 15mm 17mm 14mm;
        break-after: page;
      }

      .contents-header,
      .chapter-banner {
        position: relative;
        overflow: hidden;
        color: #fff;
        background: var(--blue);
      }

      .contents-header {
        min-height: 50mm;
        margin: -15mm -17mm 9mm;
        padding: 18mm 17mm;
        display: flex;
        align-items: center;
      }

      .contents-header::after,
      .chapter-banner::after {
        content: "";
        position: absolute;
        right: -11mm;
        bottom: -19mm;
        width: 61mm;
        height: 45mm;
        border: 1.5mm solid rgba(255,255,255,.3);
        border-radius: 50%;
      }

      .contents h1 {
        margin: 0;
        font-size: 32pt;
        letter-spacing: -.02em;
      }

      .contents-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3mm;
        width: 100%;
        margin: auto 0;
        padding: 0;
        list-style: none;
      }

      .contents-item {
        display: grid;
        grid-template-columns: 13mm minmax(0, 1fr);
        gap: 4mm;
        align-items: center;
        min-height: 20mm;
        padding: 3mm 6mm 3mm 4mm;
        border: .45mm solid var(--line);
        border-left: 2mm solid var(--blue);
        border-radius: 3mm;
        background: linear-gradient(90deg, var(--blue-soft), var(--blue-pale));
        break-inside: avoid;
      }

      .contents-item > div {
        padding-right: 22mm;
      }

      .contents-number,
      .section-number {
        display: grid;
        place-items: center;
        color: #fff;
        background: var(--blue);
        font-weight: 900;
      }

      .contents-number {
        width: 11mm;
        height: 11mm;
        border-radius: 3mm;
        font-size: 13pt;
      }

      .contents-item h2 {
        margin: 0;
        font-size: 12.5pt;
        line-height: 1.25;
      }

      .contents-item p {
        margin: 1mm 0 0;
        color: #557083;
        font-size: 8.5pt;
      }

      .chapter {
        padding: 0 17mm 14mm;
        break-before: page;
      }

      .chapter-banner {
        min-height: 65mm;
        margin: 0 -17mm 12mm;
        padding: 15mm 17mm 12mm;
        clear: both;
        break-inside: avoid;
        background:
          linear-gradient(135deg, var(--blue) 0 76%, #68c8eb 76.2% 100%);
      }

      .chapter-kicker {
        margin: 0 0 4mm;
        color: var(--yellow);
        font-size: 10pt;
        font-weight: 900;
        letter-spacing: .06em;
        text-transform: uppercase;
      }

      .chapter-banner h1 {
        max-width: 155mm;
        margin: 0;
        font-size: 24pt;
        line-height: 1.16;
      }

      .chapter-banner p {
        max-width: 145mm;
        margin: 5mm 0 0;
        font-size: 11.5pt;
      }

      .guide--student .chapter--chapter-6 .chapter-banner {
        min-height: 34mm;
        margin-bottom: 2mm;
        padding-top: 5mm;
        padding-bottom: 5mm;
      }

      .guide--student .chapter--chapter-6 .guide-section {
        padding-top: 3mm;
        padding-bottom: 3mm;
      }

      .guide--student .chapter--chapter-6 .section-number {
        top: 3mm;
      }

      .chapter--chapter-6 .guide-section--standard-standalone-top {
        padding-top: 8mm;
      }

      .chapter--chapter-6 .guide-section--standard-standalone-top .section-number {
        top: 8mm;
      }

      .chapter--chapter-6 .section-body h2 {
        margin-bottom: 2mm;
      }

      .chapter--chapter-6 .steps {
        margin: 2mm 0;
      }

      .chapter--chapter-6 .steps li {
        min-height: 7mm;
        margin-bottom: 1.7mm;
        padding-top: 1.5mm;
        padding-bottom: 1.5mm;
      }

      .chapter--chapter-6 .steps li::before {
        top: 1.25mm;
      }

      .chapter--chapter-6 .guide-note {
        margin: 3mm 0;
        padding: 3mm 4mm;
      }

      .chapter-checklist {
        margin: 0 0 9mm;
        padding: 5mm 7mm;
        border-left: 2mm solid var(--yellow);
        border-radius: 0 3mm 3mm 0;
        background: #fff9db;
        break-inside: avoid;
      }

      .chapter-checklist ul {
        margin: 0;
        padding-left: 6mm;
      }

      .guide-section {
        position: relative;
        display: block;
        padding: 8mm 0 8mm 21mm;
        border-top: .4mm solid #d7edf6;
      }

      .guide-section:first-of-type {
        border-top: 0;
      }

      .guide-section--compact {
        break-inside: avoid-page;
      }

      .guide-section--large-centered-phone-page {
        break-inside: avoid-page;
      }

      .guide-section--tc-final-help-start {
        padding-top: 60mm;
      }

      .guide-section--tc-final-help-start .section-number {
        top: 60mm;
      }

      .guide-section--vertically-centered {
        padding-top: 65mm;
      }

      .guide-section--vertically-centered .section-number {
        top: 65mm;
      }

      .guide-section--student-vertically-centered {
        padding-top: 85mm;
      }

      .guide-section--student-vertically-centered .section-number {
        top: 85mm;
      }

      .guide-section--deeply-balanced {
        padding-top: 50mm;
      }

      .guide-section--deeply-balanced .section-number {
        top: 50mm;
      }

      .guide-section--balanced {
        padding-top: 35mm;
      }

      .guide-section--balanced .section-number {
        top: 35mm;
      }

      .guide-section--subtly-balanced {
        padding-top: 20mm;
      }

      .guide-section--subtly-balanced .section-number {
        top: 20mm;
      }

      .chapter--chapter-6 .guide-section--deeply-balanced {
        padding-top: 50mm;
      }

      .chapter--chapter-6 .guide-section--deeply-balanced .section-number {
        top: 50mm;
      }

      .guide--student .chapter--chapter-6 .guide-section--deeply-balanced {
        padding-top: 50mm;
      }

      .guide--student .chapter--chapter-6 .guide-section--deeply-balanced .section-number {
        top: 50mm;
      }

      .guide-section--chapter-2-compact {
        padding-top: 5mm;
        padding-bottom: 5mm;
      }

      .guide-section--chapter-2-compact .steps li {
        min-height: 7.5mm;
        margin-bottom: 2mm;
        padding-top: 1.8mm;
        padding-bottom: 1.8mm;
      }

      .guide-section--chapter-2-compact .steps li::before {
        top: 1.55mm;
      }

      .guide-section--chapter-2-compact .app-screenshot--primary {
        width: 45mm;
      }

      .guide-section--chapter-2-compact .app-screenshot--primary .screenshot-frame {
        max-width: 45mm;
      }

      .guide-section--chapter-2-compact .app-screenshot--primary .screenshot-frame img {
        max-width: 40.6mm;
        max-height: 88mm;
      }

      .guide-section--chapter-3-pair {
        padding-top: 3mm;
        padding-bottom: 3mm;
      }

      .guide-section--chapter-4-combined {
        padding-top: 5mm;
        padding-bottom: 5mm;
        break-inside: avoid-page;
      }

      .guide-section--chapter-4-combined .section-number {
        top: 5mm;
      }

      .guide-section--chapter-4-combined.guide-section--subtly-balanced {
        padding-top: 20mm;
      }

      .guide-section--chapter-4-combined.guide-section--subtly-balanced .section-number {
        top: 20mm;
      }

      .guide-section--chapter-4-combined .section-body h2 {
        margin-bottom: 2mm;
        font-size: 15pt;
      }

      .guide-section--chapter-4-combined .section-body p,
      .guide-section--chapter-4-combined .steps {
        margin-top: 2mm;
        margin-bottom: 2mm;
      }

      .guide-section--chapter-4-combined .steps li {
        min-height: 7.5mm;
        margin-bottom: 2mm;
        padding-top: 1.8mm;
        padding-bottom: 1.8mm;
      }

      .guide-section--chapter-4-combined .steps li::before {
        top: 1.55mm;
      }

      .guide-section--chapter-3-pair .section-body h2 {
        margin-bottom: 2mm;
        font-size: 15pt;
      }

      .guide-section--chapter-3-pair .section-body p {
        margin: 2mm 0;
      }

      .guide-section--student-chapter-5-pair {
        padding-top: 3mm;
        padding-bottom: 3mm;
      }

      .guide-section--student-chapter-5-pair .section-body h2 {
        margin-bottom: 2mm;
        font-size: 15pt;
      }

      .guide-section--student-chapter-5-pair .steps,
      .guide-section--student-chapter-5-pair .detail-list {
        margin-top: 2mm;
        margin-bottom: 2mm;
      }

      .guide-section--student-chapter-5-pair .steps li {
        min-height: 7.5mm;
        margin-bottom: 2mm;
        padding-top: 1.8mm;
        padding-bottom: 1.8mm;
      }

      .guide-section--student-chapter-5-pair .steps li::before {
        top: 1.55mm;
      }

      .guide-section--compact-text-chapter {
        padding-top: 4mm;
        padding-bottom: 4mm;
      }

      .guide-section--compact-text-chapter .section-number {
        top: 4mm;
      }

      .guide-section--compact-text-chapter .section-body h2 {
        margin-bottom: 2mm;
        font-size: 15pt;
      }

      .guide-section--compact-text-chapter .section-body p,
      .guide-section--compact-text-chapter .detail-list {
        margin-top: 2mm;
        margin-bottom: 2mm;
      }

      .guide-section--compact-text-chapter .detail-list li {
        margin: .8mm 0;
      }

      .guide-section--review-generated {
        padding: 3mm 0 3mm 16mm;
      }

      .guide-section--review-generated .section-number {
        top: 3mm;
        width: 11mm;
        height: 11mm;
        font-size: 9pt;
      }

      .guide-section--review-generated .section-body h2 {
        margin-bottom: 1.5mm;
        font-size: 13pt;
      }

      .guide-section--review-generated .steps {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2mm;
        margin: 0;
      }

      .guide-section--review-generated .steps li {
        min-height: 7mm;
        margin: 0;
        padding: 1.5mm 2.5mm 1.5mm 10mm;
        font-size: 9pt;
      }

      .guide-section--review-generated .steps li::before {
        left: 2mm;
        top: 1.25mm;
        width: 5mm;
        height: 5mm;
        font-size: 7pt;
      }

      .section-number {
        position: absolute;
        left: 0;
        top: 8mm;
        width: 15mm;
        height: 15mm;
        border-radius: 4mm 4mm 4mm 1mm;
        font-size: 11pt;
        align-self: start;
      }

      .section-body {
        min-width: 0;
      }

      .section-layout {
        min-width: 0;
      }

      .section-layout--with-media {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 55mm;
        gap: 6mm;
        align-items: start;
        break-inside: avoid-page;
      }

      .section-layout--paired {
        display: block;
        break-inside: avoid-page;
      }

      .section-layout--chapter-4-final {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 82mm;
        gap: 6mm;
        align-items: start;
        break-inside: avoid-page;
      }

      .section-layout--chapter-4-final .section-media-stack {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 4mm;
      }

      .section-layout--chapter-4-final .app-screenshot--primary,
      .section-layout--chapter-4-final .app-screenshot--stacked {
        width: 39mm;
        margin: 0 auto;
      }

      .section-layout--chapter-4-final .app-screenshot--primary .screenshot-frame,
      .section-layout--chapter-4-final .app-screenshot--stacked .screenshot-frame {
        max-width: 39mm;
      }

      .section-layout--chapter-4-final .app-screenshot--primary .screenshot-frame img,
      .section-layout--chapter-4-final .app-screenshot--stacked .screenshot-frame img {
        max-width: 34.6mm;
        max-height: 76mm;
      }

      .section-layout--chapter-4-final figcaption {
        font-size: 7pt;
      }

      .section-copy {
        min-width: 0;
      }

      .section-body h2 {
        margin: 0 0 4mm;
        font-size: 17pt;
        line-height: 1.22;
      }

      .section-body p {
        margin: 3mm 0;
      }

      .section-introduction {
        color: #3d6077;
        font-size: 11pt;
      }

      .steps {
        display: flow-root;
        margin: 4mm 0;
        padding: 0;
        list-style: none;
        counter-reset: steps;
      }

      .steps li {
        position: relative;
        min-height: 9mm;
        margin: 0 0 3mm;
        padding: 2.5mm 4mm 2.5mm 13mm;
        border-radius: 3mm;
        background: var(--blue-soft);
        counter-increment: steps;
        break-inside: avoid;
      }

      .steps li::before {
        content: counter(steps);
        position: absolute;
        left: 3mm;
        top: 2.2mm;
        display: grid;
        place-items: center;
        width: 6.5mm;
        height: 6.5mm;
        border-radius: 50%;
        color: #fff;
        background: var(--blue-deep);
        font-size: 8pt;
        font-weight: 900;
      }

      .detail-list {
        display: flow-root;
        margin: 4mm 0;
        padding-left: 7mm;
      }

      .detail-list li {
        margin: 1.5mm 0;
      }

      .detail-list li::marker {
        color: var(--blue);
      }

      .guide-note {
        display: flow-root;
        margin: 5mm 0;
        padding: 4mm 5mm;
        border: .45mm dashed var(--blue);
        border-radius: 3mm;
        background: var(--blue-pale);
        break-inside: avoid;
      }

      .guide-note strong {
        color: var(--blue-deep);
      }

      .guide-note p {
        margin-bottom: 0;
      }

      .app-screenshot,
      .screenshot-placeholder {
        margin: 7mm auto;
        text-align: center;
        break-inside: avoid;
      }

      .app-screenshot--primary {
        float: none;
        width: 55mm;
        margin: 0;
      }

      .section-media-stack {
        display: grid;
        gap: 4mm;
        align-content: start;
        break-inside: avoid-page;
      }

      .section-layout--paired .section-media-stack {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10mm;
        margin-top: 5mm;
      }

      .screenshot-frame {
        position: relative;
        display: inline-block;
        max-width: 72mm;
        padding: 2.2mm;
        border-radius: 7mm;
        background: #10283f;
      }

      .screenshot-image {
        position: relative;
        display: inline-block;
        vertical-align: top;
        line-height: 0;
      }

      .screenshot-frame img {
        display: block;
        max-width: 67.6mm;
        max-height: 150mm;
        width: auto;
        height: auto;
        border-radius: 5mm;
      }

      .app-screenshot--primary .screenshot-frame {
        max-width: 55mm;
      }

      .app-screenshot--primary .screenshot-frame img {
        max-width: 50.6mm;
        max-height: 105mm;
      }

      .section-layout--large-centered-phone {
        display: block;
      }

      .section-layout--large-centered-phone .section-copy {
        max-width: none;
      }

      .section-layout--large-centered-phone .section-media-stack {
        display: block;
        width: 78mm;
        margin: 7mm auto 0;
      }

      .section-layout--large-centered-phone .app-screenshot--primary {
        width: 78mm;
        margin: 0 auto;
      }

      .section-layout--large-centered-phone .app-screenshot--primary .screenshot-frame {
        max-width: 78mm;
      }

      .section-layout--large-centered-phone .app-screenshot--primary .screenshot-frame img {
        max-width: 73.6mm;
        max-height: 155mm;
      }

      .section-layout--large-centered-phone figcaption {
        width: fit-content;
        max-width: 105mm;
        margin-top: 3mm;
        padding-right: 3mm;
        padding-left: 3mm;
        font-size: 9pt;
      }

      .section-layout--medium-centered-phone {
        display: block;
      }

      .section-layout--medium-centered-phone .section-copy {
        max-width: none;
      }

      .section-layout--medium-centered-phone .section-media-stack {
        display: block;
        width: 65mm;
        margin: 7mm auto 0;
      }

      .section-layout--medium-centered-phone .app-screenshot--primary {
        width: 65mm;
        margin: 0 auto;
      }

      .section-layout--medium-centered-phone .app-screenshot--primary .screenshot-frame {
        max-width: 65mm;
      }

      .section-layout--medium-centered-phone .app-screenshot--primary .screenshot-frame img {
        max-width: 60.6mm;
        max-height: 130mm;
      }

      .section-layout--medium-centered-phone figcaption {
        width: fit-content;
        max-width: 95mm;
        margin-top: 3mm;
        padding-right: 2.5mm;
        padding-left: 2.5mm;
        font-size: 8.8pt;
      }

      .app-screenshot--stacked {
        width: 55mm;
        margin: 0 auto;
      }

      .app-screenshot--stacked .screenshot-frame {
        max-width: 55mm;
      }

      .app-screenshot--stacked .screenshot-frame img {
        max-width: 50.6mm;
        max-height: 105mm;
      }

      .app-screenshot--stacked figcaption {
        font-size: 8.5pt;
      }

      .section-layout--paired .app-screenshot--primary,
      .section-layout--paired .app-screenshot--stacked {
        justify-self: center;
      }

      .chapter--chapter-6 .section-layout--paired .app-screenshot--primary,
      .chapter--chapter-6 .section-layout--paired .app-screenshot--stacked {
        width: 42mm;
      }

      .chapter--chapter-6 .section-layout--paired .app-screenshot--primary .screenshot-frame,
      .chapter--chapter-6 .section-layout--paired .app-screenshot--stacked .screenshot-frame {
        max-width: 42mm;
      }

      .chapter--chapter-6 .section-layout--paired .app-screenshot--primary .screenshot-frame img,
      .chapter--chapter-6 .section-layout--paired .app-screenshot--stacked .screenshot-frame img {
        max-width: 37.6mm;
        max-height: 78mm;
      }

      .section-layout--chapter-6-followup {
        grid-template-columns: minmax(0, 1fr) 40mm;
        gap: 4mm;
      }

      .section-layout--chapter-6-followup .app-screenshot--primary,
      .section-layout--chapter-6-followup .app-screenshot--stacked {
        width: 40mm;
      }

      .section-layout--chapter-6-followup .screenshot-frame {
        max-width: 40mm;
      }

      .section-layout--chapter-6-followup .screenshot-frame img {
        max-width: 35.6mm;
        max-height: 78mm;
      }

      .section-layout--chapter-6-followup figcaption {
        font-size: 7.5pt;
      }

      .guide-section--student-6-2-balance .section-layout--paired .section-media-stack {
        gap: 10mm;
        margin-top: 8mm;
      }

      .guide-section--student-6-2-balance .section-layout--paired .app-screenshot--primary,
      .guide-section--student-6-2-balance .section-layout--paired .app-screenshot--stacked {
        width: 65mm;
      }

      .guide-section--student-6-2-balance .section-layout--paired .app-screenshot--primary .screenshot-frame,
      .guide-section--student-6-2-balance .section-layout--paired .app-screenshot--stacked .screenshot-frame {
        max-width: 65mm;
      }

      .guide-section--student-6-2-balance .section-layout--paired .app-screenshot--primary .screenshot-frame img,
      .guide-section--student-6-2-balance .section-layout--paired .app-screenshot--stacked .screenshot-frame img {
        max-width: 60.6mm;
        max-height: 130mm;
      }

      .additional-screenshots {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 4mm;
        margin-top: 4mm;
      }

      .additional-screenshots--teacher {
        gap: 7mm;
        margin-top: 5mm;
        padding-top: 22mm;
        break-before: page;
        break-inside: avoid-page;
      }

      .additional-screenshots--centered-continuation {
        padding-top: 22mm;
      }

      .additional-screenshots-title {
        grid-column: 1 / -1;
        margin: 0;
        padding-bottom: 2mm;
        border-bottom: .45mm solid var(--line);
        color: var(--blue-deep);
        font-size: 13pt;
        line-height: 1.25;
      }

      .additional-screenshots .app-screenshot {
        margin: 0;
      }

      .additional-screenshots .screenshot-frame {
        max-width: 55mm;
      }

      .additional-screenshots .screenshot-frame img {
        max-width: 50.6mm;
        max-height: 105mm;
      }

      .additional-screenshots--teacher .screenshot-frame {
        max-width: 60mm;
      }

      .additional-screenshots--teacher .screenshot-frame img {
        max-width: 55.6mm;
        max-height: 125mm;
      }

      .additional-screenshots--three-across {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: 10mm;
        row-gap: 6mm;
        padding-top: 22mm;
      }

      .additional-screenshots--three-across .screenshot-frame {
        max-width: 48mm;
      }

      .additional-screenshots--three-across .screenshot-frame img {
        max-width: 43.6mm;
        max-height: 105mm;
      }

      .additional-screenshots--three-across figcaption {
        font-size: 8.5pt;
      }

      .additional-screenshots--three-across .app-screenshot:last-child {
        grid-column: 1 / -1;
        justify-self: center;
        width: 48mm;
      }

      .additional-screenshots--student-safety-balance {
        padding-top: 20mm;
      }

      .additional-screenshots--student-safety-balance .screenshot-frame {
        max-width: 65mm;
      }

      .additional-screenshots--student-safety-balance .screenshot-frame img {
        max-width: 60.6mm;
        max-height: 125mm;
      }

      .guide-section--student-chapter-4-spacing .additional-screenshots {
        margin-top: 10mm;
      }

      .guide-section--export-pdf .section-layout--with-media {
        grid-template-columns: minmax(0, 1fr) 70mm;
      }

      .guide-section--export-pdf .app-screenshot--primary {
        width: 70mm;
      }

      .guide-section--export-pdf .app-screenshot--primary .screenshot-frame {
        max-width: 70mm;
      }

      .guide-section--export-pdf .app-screenshot--primary .screenshot-frame img {
        max-width: 65.6mm;
        max-height: 155mm;
      }

  .screenshot-highlight {
    position: absolute;
    outline: .65mm solid var(--coral);
    outline-offset: .35mm;
    border-radius: 2mm;
  }

      .screenshot-highlight--circle {
        border-radius: 50%;
      }

      figcaption {
        display: table;
        width: fit-content;
        max-width: 120mm;
        margin: 3mm auto 0;
        padding: .4mm 1.3mm;
        border-radius: 2mm;
        color: #455d6d;
        background: #eef1f3;
        font-size: 8.5pt;
        line-height: 1.4;
        overflow-wrap: anywhere;
        white-space: normal;
      }

      .screenshot-placeholder {
        padding: 8mm;
        border: .5mm dashed var(--line);
        border-radius: 4mm;
        color: #557083;
        background: var(--blue-pale);
      }

      .completion {
        position: relative;
        clear: both;
        margin-top: 10mm;
        padding: 7mm 9mm;
        overflow: hidden;
        border-radius: 4mm;
        color: #fff;
        background: var(--blue-deep);
        break-inside: avoid;
      }

      .completion::after {
        content: "★";
        position: absolute;
        right: 8mm;
        top: 50%;
        color: var(--yellow);
        font-size: 24pt;
        transform: translateY(-50%) rotate(10deg);
      }

      .completion strong {
        display: block;
        margin-bottom: 1.5mm;
        color: var(--yellow);
        font-size: 9pt;
        letter-spacing: .06em;
        text-transform: uppercase;
      }

      .completion p {
        max-width: 145mm;
        margin: 0;
        padding-right: 15mm;
        font-size: 13pt;
        font-weight: 700;
      }

      .ending {
        position: relative;
        display: grid;
        grid-template-rows: auto 1fr auto;
        min-height: 297mm;
        padding: 18mm 20mm;
        overflow: hidden;
        break-before: page;
        background:
          linear-gradient(160deg, transparent 0 57%, rgba(255,255,255,.18) 57.2% 100%),
          linear-gradient(145deg, #fff 0 52%, #dff5fc 52.2% 65%, #26a9df 65.2% 100%);
      }

      .ending::after {
        content: "";
        position: absolute;
        right: -28mm;
        bottom: 28mm;
        width: 100mm;
        height: 100mm;
        border: 2mm solid rgba(255,255,255,.28);
        border-radius: 50%;
      }

      .ending-logo {
        position: relative;
        z-index: 2;
        width: 53mm;
        height: auto;
      }

      .ending-main {
        position: relative;
        z-index: 2;
        align-self: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-bottom: 20mm;
        text-align: center;
      }

      .ending-rabbit {
        display: block;
        width: 68mm;
        height: auto;
        margin-bottom: 7mm;
      }

      .ending-copy {
        max-width: 145mm;
        padding: 9mm 12mm;
        border-radius: 6mm;
        background: rgba(255,255,255,.9);
      }

      .ending-eyebrow {
        margin: 0 0 3mm;
        color: var(--blue-deep);
        font-size: 10pt;
        font-weight: 900;
        letter-spacing: .06em;
        text-transform: uppercase;
      }

      .ending h1 {
        margin: 0;
        font-size: 28pt;
        line-height: 1.15;
      }

      .ending-body {
        margin: 5mm auto 0;
        color: #3d6077;
        font-size: 13pt;
        line-height: 1.55;
      }

      .ending-download {
        position: relative;
        z-index: 2;
        align-self: end;
        display: flex;
        align-items: center;
        gap: 5mm;
        color: #fff;
      }

      .ending-download img {
        display: block;
        width: 29mm;
        height: 29mm;
        padding: 1.5mm;
        border-radius: 2mm;
        background: #fff;
      }

      .ending-download strong,
      .ending-download span {
        display: block;
      }

      .ending-download strong {
        max-width: 88mm;
        font-size: 11pt;
        line-height: 1.35;
      }

      .ending-download span {
        margin-top: 1.5mm;
        font-size: 9pt;
        font-weight: 700;
      }

      @page {
        size: A4;
        margin: 0;
      }

      @media print {
        html,
        body {
          background: #fff;
        }

        body {
          max-width: none;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        a {
          color: inherit;
          text-decoration: none;
        }
      }
    </style>
  </head>
  <body class={isStudent ? 'guide--student' : 'guide--teacher'}>
    <section class="cover">
      <img class="cover-logo" src={assetSrc('/hoppy-logo-clean.png')} alt="Hoppy" />
      <div class="cover-rabbit" aria-hidden="true">
        <img src={assetSrc('/hoppy-rabbit-official-cover.svg')} alt="" />
      </div>
      <div class="cover-download">
        <img src={assetSrc('/hoppy-download-qr.png')} alt={copy.downloadQrAlt} />
        <span>{copy.downloadApp}</span>
      </div>
      <div class="cover-copy">
        <p class="cover-eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
        <p class="cover-summary">{copy.summary}</p>
      </div>
      <div class="cover-meta">
        <span>{copy.edition}</span>
      </div>
    </section>

    <section class="contents">
      <header class="contents-header">
        <h1>{copy.contents}</h1>
      </header>
      <ol class="contents-list">
        {chapters.map((chapter) => (
          <li class="contents-item">
            <span class="contents-number">{chapter.number}</span>
            <div>
              <h2>{chapter.title}</h2>
              <p>{chapter.sections.length} {copy.sections}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {chapters.map((chapter) => (
      <article class:list={['chapter', `chapter--${chapter.slug}`]} id={chapter.slug}>
        <header class="chapter-banner">
          <p class="chapter-kicker">{isTc ? `第${chapter.number}章` : `${copy.chapter} ${chapter.number}`}</p>
          <h1>{chapter.title}</h1>
          <p>{chapter.summary}</p>
        </header>

        {chapter.chapterBullets && (
          <aside class="chapter-checklist">
            <ul>
              {chapter.chapterBullets.map((item) => <li>{item}</li>)}
            </ul>
          </aside>
        )}

        {chapter.sections.map((section) => (
          <section
            class:list={[
              'guide-section',
              {
                'guide-section--visual':
                  section.screenshot || section.additionalScreenshots?.length,
                'guide-section--compact':
                  !section.screenshot && !section.additionalScreenshots?.length,
                'guide-section--large-centered-phone-page':
                  section.screenshot &&
                  typeof section.screenshot !== 'string' &&
                  !section.additionalScreenshots?.length &&
                  (largeCenteredPhoneSections.has(section.number) ||
                    mediumCenteredPhoneSections.has(section.number)),
                'guide-section--standard-standalone-top':
                  !isStudent && section.number === '6.2',
                'guide-section--student-6-2-balance':
                  isStudent && section.number === '6.2',
                'guide-section--tc-final-help-start':
                  !isStudent && isTc && section.number === '11.5',
                'guide-section--vertically-centered':
                  verticallyCenteredSections.has(section.number),
                'guide-section--student-vertically-centered':
                  isStudent && section.number === '4.4',
                'guide-section--deeply-balanced':
                  deeplyBalancedSections.has(section.number),
                'guide-section--balanced': balancedSections.has(section.number),
                'guide-section--subtly-balanced':
                  subtlyBalancedSections.has(section.number),
                'guide-section--chapter-2-compact':
                  chapter.number === 2 && (section.number === '2.4' || section.number === '2.5'),
                'guide-section--chapter-3-pair':
                  !isStudent &&
                  chapter.number === 3 &&
                  (section.number === '3.3' || section.number === '3.4'),
                'guide-section--chapter-4-combined':
                  !isStudent &&
                  chapter.number === 4 &&
                  (section.number === '4.4' || section.number === '4.5'),
                'guide-section--student-chapter-5-pair':
                  isStudent &&
                  chapter.number === 5 &&
                  (section.number === '5.4' || section.number === '5.5'),
                'guide-section--student-chapter-4-spacing':
                  isStudent &&
                  chapter.number === 4 &&
                  (section.number === '4.2' || section.number === '4.3'),
                'guide-section--compact-text-chapter':
                  (isStudent && chapter.number === 7) ||
                  (!isStudent && chapter.number === 10),
                'guide-section--review-generated':
                  chapter.number === 2 && section.number === '2.6',
                'guide-section--export-pdf':
                  !isStudent && section.number === '3.6',
              },
            ]}
            id={sectionId(section.number)}
          >
            <div class="section-number" aria-hidden="true">{section.number}</div>
            <div class="section-body">
              <div
                class={
                  section.screenshot && typeof section.screenshot !== 'string'
                    ? section.additionalScreenshots?.length === 1
                      ? audience === 'teacher' && chapter.number === 4 && section.number === '4.5'
                        ? 'section-layout section-layout--chapter-4-final'
                        : audience === 'teacher' && chapter.number === 6 && section.number === '6.1'
                        ? 'section-layout section-layout--with-media section-layout--chapter-6-followup'
                        : 'section-layout section-layout--paired'
                      : !section.additionalScreenshots?.length &&
                          largeCenteredPhoneSections.has(section.number)
                        ? 'section-layout section-layout--large-centered-phone'
                        : !section.additionalScreenshots?.length &&
                            mediumCenteredPhoneSections.has(section.number)
                          ? 'section-layout section-layout--medium-centered-phone'
                        : 'section-layout section-layout--with-media'
                    : 'section-layout'
                }
              >
                <div class="section-copy">
                  <h2>{section.title}</h2>
                  {section.introduction && <p class="section-introduction">{section.introduction}</p>}

                  {section.steps && (
                    <ol class="steps">
                      {section.steps.map((step) => <li>{step}</li>)}
                    </ol>
                  )}

                  {section.bullets && (
                    <ul class="detail-list">
                      {section.bullets.map((item) => <li>{item}</li>)}
                    </ul>
                  )}

                  {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}

                  {section.note && (
                    <aside class="guide-note">
                      <strong>{section.note.title}</strong>
                      <p>{section.note.text}</p>
                    </aside>
                  )}

                  {typeof section.screenshot === 'string' && (
                    <figure class="screenshot-placeholder">
                      <strong>{copy.screenshotPending}</strong>
                      <figcaption>{section.screenshot}</figcaption>
                    </figure>
                  )}
                </div>

                {section.screenshot && typeof section.screenshot !== 'string' && (
                  <div class="section-media-stack">
                    <figure class="app-screenshot app-screenshot--primary">
                      <div class="screenshot-frame">
                        <div class="screenshot-image">
                          <img src={assetSrc(section.screenshot.src)} alt={section.screenshot.alt} />
                          {section.screenshot.highlights?.map((highlight) => (
                            <span
                              class:list={[
                                'screenshot-highlight',
                                {
                                  'screenshot-highlight--circle':
                                    highlight.width <= 8 && highlight.height <= 4.5,
                                },
                              ]}
                              style={`left:${highlight.left}%;top:${highlight.top}%;width:${highlight.width}%;height:${highlight.height}%;`}
                              aria-hidden="true"
                            />
                          ))}
                        </div>
                      </div>
                      <figcaption>{section.screenshot.caption}</figcaption>
                    </figure>

                    {section.additionalScreenshots?.length === 1 && (
                      <figure class="app-screenshot app-screenshot--stacked">
                        <div class="screenshot-frame">
                          <div class="screenshot-image">
                            <img
                              src={assetSrc(section.additionalScreenshots[0].src)}
                              alt={section.additionalScreenshots[0].alt}
                            />
                            {section.additionalScreenshots[0].highlights?.map((highlight) => (
                              <span
                                class:list={[
                                  'screenshot-highlight',
                                  {
                                    'screenshot-highlight--circle':
                                      highlight.width <= 8 && highlight.height <= 4.5,
                                  },
                                ]}
                                style={`left:${highlight.left}%;top:${highlight.top}%;width:${highlight.width}%;height:${highlight.height}%;`}
                                aria-hidden="true"
                              />
                            ))}
                          </div>
                        </div>
                        <figcaption>{section.additionalScreenshots[0].caption}</figcaption>
                      </figure>
                    )}
                  </div>
                )}
              </div>

              {section.additionalScreenshots && section.additionalScreenshots.length > 1 && (
                <div
                  class:list={[
                    'additional-screenshots',
                    {
                      'additional-screenshots--teacher': !isStudent,
                      'additional-screenshots--centered-continuation':
                        !isStudent && (section.number === '3.1' || section.number === '9.1'),
                      'additional-screenshots--three-across':
                        !isStudent && chapter.number === 8 && section.number === '8.1',
                      'additional-screenshots--student-safety-balance':
                        isStudent && chapter.number === 7 && section.number === '7.3',
                    },
                  ]}
                >
                  {!isStudent && (
                    <h3 class="additional-screenshots-title">
                      {section.number} {section.title} {copy.continued}
                    </h3>
                  )}
                  {section.additionalScreenshots.map((screenshot) => (
                    <figure class="app-screenshot">
                      <div class="screenshot-frame">
                        <div class="screenshot-image">
                          <img src={assetSrc(screenshot.src)} alt={screenshot.alt} />
                          {screenshot.highlights?.map((highlight) => (
                            <span
                              class:list={[
                                'screenshot-highlight',
                                {
                                  'screenshot-highlight--circle':
                                    highlight.width <= 8 && highlight.height <= 4.5,
                                },
                              ]}
                              style={`left:${highlight.left}%;top:${highlight.top}%;width:${highlight.width}%;height:${highlight.height}%;`}
                              aria-hidden="true"
                            />
                          ))}
                        </div>
                      </div>
                      <figcaption>{screenshot.caption}</figcaption>
                    </figure>
                  ))}
                </div>
              )}
            </div>
          </section>
        ))}

      </article>
    ))}

    <section class="ending">
      <img class="ending-logo" src={assetSrc('/hoppy-logo-clean.png')} alt="Hoppy" />
      <div class="ending-main">
        <img
          class="ending-rabbit"
          src={assetSrc('/hoppy-rabbit-official-cover.svg')}
          alt=""
          aria-hidden="true"
        />
        <div class="ending-copy">
          <p class="ending-eyebrow">{copy.endingEyebrow}</p>
          <h1>{copy.endingTitle}</h1>
          <p class="ending-body">{copy.endingBody}</p>
        </div>
      </div>
      <div class="ending-download">
        <img src={assetSrc('/hoppy-download-qr.png')} alt={copy.downloadQrAlt} />
        <div>
          <strong>{copy.endingAction}</strong>
          <span>{copy.website}</span>
        </div>
      </div>
    </section>
  </body>
</html>
