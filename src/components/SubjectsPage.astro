---

<Layout lang={lang}>
  <main>
    <!-- Hero Section -->
    <section class={selectedSubject ? 'hero' : 'hero subject-hub-hero'}>
      <div class="hero-content">
        <h1>{selectedSubject && currentSubject ? t(`subjects.${selectedSubject}.pageTitle`) : t('subjects.title')}</h1>
        <p class="hero-description">
          {selectedSubject && currentSubject
            ? t(currentSubject.descriptionKey)
            : t('subjects.description')}
        </p>
      </div>
    </section>

    {selectedSubject ? (
      <SubjectNavigation lang={lang} level={selectedLevel ?? 'secondary'} currentSubject={selectedSubject} />
    ) : (
      <>
        <SubjectNavigation lang={lang} level={selectedLevel ?? 'primary'} />
        <section class="subject-hub" aria-labelledby="subject-hub-title">
          <h2 id="subject-hub-title" class="visually-hidden">{t('subjects.hubTitle')}</h2>
          {visibleSubjectSections.map((section) => (
            <section class="school-level-section" aria-labelledby={`${section.id}-subjects-title`}>
              <div class="school-level-heading">
                <span class="school-level-kicker">{t('subjects.schoolLevelLabel')}</span>
                <h2 id={`${section.id}-subjects-title`}>{t(section.titleKey)}</h2>
                <p>{t(section.descriptionKey)}</p>
              </div>
              <div class="subject-card-grid">
                {section.subjects.map((subject) => subject.comingSoon ? (
                  <a class="subject-card subject-card--coming-soon" href={`${langPrefix}/subjects/${section.id}/${subject.id}`}>
                    <div class={`subject-card-image subject-card-visual subject-card-visual--${subject.id}`} aria-hidden="true">
                      <span class="subject-icon">{subject.icon}</span>
                    </div>
                    <div class="subject-card-copy">
                      <h3>{t(subject.labelKey)}</h3>
                      <p>{t(subject.descriptionKey)}</p>
                      <span class="subject-status">{t('subjects.comingSoon')}</span>
                    </div>
                  </a>
                ) : (
                  <a class="subject-card" href={`${langPrefix}/subjects/${section.id}/${subject.id}`}>
                    <div class={`subject-card-image subject-card-visual subject-card-visual--${subject.id}`} aria-hidden="true">
                      <span class="subject-icon">{subject.icon}</span>
                    </div>
                    <div class="subject-card-copy">
                      <h3>{t(subject.labelKey)}</h3>
                      <p>{t(subject.descriptionKey)}</p>
                      <span>{t('subjects.exploreSubject')} <span aria-hidden="true">→</span></span>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </section>
      </>
    )}

    <!-- Widgets Gallery -->
    {selectedSubject && (
    <section class="widgets-gallery">

      {currentSubject?.comingSoon && (
        <section class="subject-coming-soon" aria-labelledby="coming-soon-title">
          <div class={`subject-card-visual subject-card-visual--${currentSubject.id}`} aria-hidden="true">
            <span class="subject-icon">{currentSubject.icon}</span>
          </div>
          <span class="subject-heading-kicker">{t('subjects.comingSoon')}</span>
          <h2 id="coming-soon-title">{t(currentSubject.labelKey)}</h2>
          <p>{t(currentSubject.descriptionKey)}</p>
          <p class="coming-soon-message">{t('subjects.comingSoonDescription')}</p>
        </section>
      )}

      {selectedSubject === 'mathematics' && selectedLevel === 'primary' && (
        <SampleQuizSection
          title={t('primaryMathematicsPage.samplePractice.title')}
          description={t('primaryMathematicsPage.samplePractice.description')}
          openPdfLabel={t('primaryMathematicsPage.samplePractice.openPdf')}
          openInAppLabel={t('primaryMathematicsPage.samplePractice.openInApp')}
          quizzes={primaryMathematicsSamplePractices}
        />
      )}

      {selectedSubject === 'general-studies' && selectedLevel === 'primary' && (
        <SampleQuizSection
          title={t('primaryGeneralStudiesPage.samplePractice.title')}
          description={t('primaryGeneralStudiesPage.samplePractice.description')}
          openPdfLabel={t('primaryGeneralStudiesPage.samplePractice.openPdf')}
          openInAppLabel={t('primaryGeneralStudiesPage.samplePractice.openInApp')}
          quizzes={primaryGeneralStudiesSamplePractices}
        />
      )}

      {selectedSubject === 'mathematics' && (<>
      {selectedLevel === 'secondary' && (
        <SampleQuizSection
          title={t('subjects.mathematics.goldQuiz.title')}
          description={t('subjects.mathematics.goldQuiz.description')}
          openPdfLabel={t('subjects.mathematics.goldQuiz.openPdf')}
          openInAppLabel={t('subjects.mathematics.goldQuiz.openInApp')}
          quizzes={mathematicsGoldQuizzes}
        />
      )}

      <div class="mathematics-level-groups">
        {mathematicsWidgetGroups
          .filter((group) => !selectedLevel || group.id === selectedLevel)
          .map((group) => (
          <section class={`mathematics-level-group mathematics-level-group--${group.id}`}>
            <span class="school-level-kicker">{t('subjects.schoolLevelLabel')}</span>
            <h2>{t(group.titleKey)}</h2>
            <div class="mathematics-widget-links">
              {group.widgets.map((widget) => (
                <a href={`#math-${widget.id}`}>
                  <span aria-hidden="true">{widget.icon}</span>
                  {t(widget.titleKey)}
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>

      <!-- Analog Clock -->
      {selectedLevel !== 'secondary' && (
      <div class="widget-section" id="math-analog-clock">
        <div class="widget-header">
          <div class="widget-icon">🕐</div>
          <div class="widget-info">
            <h2>{t('widgets.analogClock.title')}</h2>
            <p>{t('widgets.analogClock.description')}</p>
          </div>
        </div>
        
        <!-- Live Screenshots -->
        <div class="subsection-label">{t('widgets.liveExamples')}</div>
        <div class="screenshots-grid">
          <div class="screenshot-card">
            <img src={screenshot("/screenshots/screenshot-analog-clock-1.jpeg")} alt="Analog clock selection question" />
          </div>
          <div class="screenshot-card">
            <img src={screenshot("/screenshots/screenshot-analog-clock-3.jpeg")} alt="Analog to digital clock conversion" />
          </div>
        </div>

        <!-- Widget Examples -->
        <div class="subsection-label">{t('widgets.widgetVariations')}</div>
        <div class="widget-examples two-column">
          <div class="widget-card">
            <img src="/widgets/widget_analogclock.svg" alt="Analog Clock without seconds" />
            <span class="widget-label">{t('widgets.analogClock.withoutSecondHand')}</span>
          </div>
          <div class="widget-card">
            <img src="/widgets/widget_analogclock_seconds.svg" alt="Analog Clock with seconds" />
            <span class="widget-label">{t('widgets.analogClock.withSecondHand')}</span>
          </div>
        </div>
      </div>
      )}

      <!-- Digital Clock -->
      {selectedLevel !== 'secondary' && (
      <div class="widget-section" id="math-digital-clock">
        <div class="widget-header">
          <div class="widget-icon">⏰</div>
          <div class="widget-info">
            <h2>{t('widgets.digitalClock.title')}</h2>
            <p>{t('widgets.digitalClock.description')}</p>
          </div>
        </div>

        <!-- Live Screenshots -->
        <div class="subsection-label">{t('widgets.liveExamples')}</div>
        <div class="screenshots-grid">
          <div class="screenshot-card">
            <img src={screenshot("/screenshots/screenshot-digital-clock-1.jpeg")} alt="Digital clock multiple choice question" />
          </div>
        </div>

        <!-- Widget Examples -->
        <div class="subsection-label">{t('widgets.widgetVariations')}</div>
        <div class="widget-examples two-column">
          <div class="widget-card dark-bg">
            <img src="/widgets/widget_digitalclock_12h.svg" alt="Digital Clock 12-hour format" />
            <span class="widget-label">{t('widgets.digitalClock.format12')}</span>
          </div>
          <div class="widget-card dark-bg">
            <img src="/widgets/widget_digitalclock_24h.svg" alt="Digital Clock 24-hour format" />
            <span class="widget-label">{t('widgets.digitalClock.format24')}</span>
          </div>
        </div>
      </div>
      )}

      <!-- Bar Chart -->
      <div class="widget-section" id="math-bar-chart">
        <div class="widget-header">
          <div class="widget-icon">📊</div>
          <div class="widget-info">
            <h2>{t('widgets.barChart.title')}</h2>
            <p>{t('widgets.barChart.description')}</p>
          </div>
        </div>

        <!-- Live Screenshots -->
        <div class="subsection-label">{t('widgets.liveExamples')}</div>
        <div class="screenshots-grid">
          <div class="screenshot-card">
            <img src={screenshot("/screenshots/screenshot-bar-chart-1.jpeg")} alt="Bar chart temperature question" />
          </div>
        </div>

        <!-- Widget Examples -->
        <div class="subsection-label">{t('widgets.widgetVariations')}</div>
        <div class="widget-examples single-column">
          <div class="widget-card large">
            <img src="/widgets/widget_barchart.svg" alt="Bar Chart Widget" />
            <span class="widget-label">{t('widgets.barChart.quarterlySales')}</span>
          </div>
        </div>
      </div>

      <!-- Stacked Bar Chart -->
      {selectedLevel !== 'primary' && (
      <div class="widget-section" id="math-stacked-bar-chart">
        <div class="widget-header">
          <div class="widget-icon">📊</div>
          <div class="widget-info">
            <h2>{t('widgets.stackedBarChart.title')}</h2>
            <p>{t('widgets.stackedBarChart.description')}</p>
          </div>
        </div>

        <!-- Live Screenshots -->
        <div class="subsection-label">{t('widgets.liveExamples')}</div>
        <div class="screenshots-grid">
          <div class="screenshot-card">
            <img src={screenshot("/screenshots/screenshot-stacked-bar-chart-1.jpeg")} alt="Stacked bar chart household expenses question" />
          </div>
          <div class="screenshot-card">
            <img src={screenshot("/screenshots/screenshot-stacked-bar-chart-2.jpeg")} alt="Stacked bar chart activity participation" />
          </div>
        </div>

        <!-- Widget Examples -->
        <div class="subsection-label">{t('widgets.widgetVariations')}</div>
        <div class="widget-examples single-column">
          <div class="widget-card large">
            <img src="/widgets/widget_stackedbarchart.svg" alt="Stacked Bar Chart Widget" />
            <span class="widget-label">{t('widgets.stackedBarChart.quarterlyRevenue')}</span>
          </div>
        </div>
      </div>
      )}

      <!-- Broken Line Graph -->
      <div class="widget-section" id="math-broken-line-graph">
        <div class="widget-header">
          <div class="widget-icon">📉</div>
          <div class="widget-info">
            <h2>{t('widgets.brokenLineGraph.title')}</h2>
            <p>{t('widgets.brokenLineGraph.description')}</p>
          </div>
        </div>

        <!-- Live Screenshots -->
        <div class="subsection-label">{t('widgets.liveExamples')}</div>
        <div class="screenshots-grid">
          <div class="screenshot-card">
            <img src={screenshot("/screenshots/screenshot-broken-line-graph-1.jpeg")} alt="Broken line graph daily steps question" />
          </div>
          <div class="screenshot-card">
            <img src={screenshot("/screenshots/screenshot-broken-line-graph-2.jpeg")} alt="Broken line graph weekly temperature" />
          </div>
        </div>

        <!-- Widget Examples -->
        <div class="subsection-label">{t('widgets.widgetVariations')}</div>
        <div class="widget-examples two-column">
          <div class="widget-card">
            <img src="/widgets/widget_brokenlinegraph.svg" alt="Broken Line Graph - Single Series" />
            <span class="widget-label">{t('widgets.brokenLineGraph.singleSeries')}</span>
          </div>
          <div class="widget-card">
            <img src="/widgets/widget_brokenlinegraph_multi.svg" alt="Broken Line Graph - Multiple Series" />
            <span class="widget-label">{t('widgets.brokenLineGraph.multipleSeries')}</span>
          </div>
        </div>
      </div>

      <!-- Box Whisker Plot -->
      {selectedLevel !== 'primary' && (
      <div class="widget-section" id="math-box-whisker">
        <div class="widget-header">
