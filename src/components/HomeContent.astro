---
import Layout from '../layouts/Layout.astro';
import { homeContent } from '../data/home';
import { getLocalizedPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = homeContent[lang];
const audiencePriority = { teachers: 0, parents: 1, students: 2 };
const audiences = [...copy.audiences].sort(
  (a, b) => audiencePriority[a.id] - audiencePriority[b.id],
);
const path = (value: string) => getLocalizedPath(value, lang);
const schoolBenefit = lang === 'tc'
  ? {
      eyebrow: '學校效益',
      title: '一個平台，涵蓋熱門學校科目。',
      description: '讓學生和教師在同一個地方使用跨科目的學習與課堂工具。',
    }
  : {
      eyebrow: 'For schools',
      title: 'One platform covering popular school subjects.',
      description: 'Give students and teachers one place for learning and classroom tools across subjects.',
    };
const teacherScreenshotRoot = lang === 'tc'
  ? '/images/teacher-guide-tc'
  : '/images/teacher-guide';
const studentScreenshotRoot = lang === 'tc'
  ? '/images/student-guide-tc'
  : '/images/student-guide';
const teacherScreenshots = [
  `${teacherScreenshotRoot}/chapter-2/quiz-description-dse.png`,
  `${teacherScreenshotRoot}/chapter-5/class-performance.png`,
  `${teacherScreenshotRoot}/chapter-7/google-classroom-linked.png`,
];
const parentScreenshots = [
  '/homepage-weekly-report.png',
  '/parent-child-quiz-review.png',
  `${teacherScreenshotRoot}/chapter-6/similar-quiz.png`,
];
const studentScreenshots = [
  `${teacherScreenshotRoot}/chapter-7/assignment-leaderboard.png`,
  `${teacherScreenshotRoot}/chapter-3/explanation-open.png`,
  `${studentScreenshotRoot}/chapter-3/xp-award.png`,
];

const getScreenshotImage = (
  audienceId: 'parents' | 'students' | 'teachers',
  screenshotIndex: number,
) => {
  if (audienceId === 'parents') {
    return parentScreenshots[screenshotIndex];
  }

  if (audienceId === 'students') {
    return studentScreenshots[screenshotIndex];
  }

  if (audienceId === 'teachers') {
    return teacherScreenshots[screenshotIndex];
  }

  return undefined;
};
---

<Layout lang={lang}>
  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{copy.heroEyebrow}</p>
          <h1>
            {copy.heroTitleStart}<span>{copy.heroTitleAccent}</span>{copy.heroTitleEnd}
          </h1>
          <p class="hero-description">{copy.heroDescription}</p>

          <div class="hero-actions">
            <a class="button button-primary" href={path('/downloadproduction')}>
              {copy.primaryAction}
            </a>
            <a class="button button-secondary" href="#audiences">
              {copy.secondaryAction}
            </a>
          </div>

          <ul class="proof-list" aria-label={copy.conceptLabel}>
            {copy.proofPoints.map((point) => <li>{point}</li>)}
          </ul>
        </div>

        <div class="hero-visual">
          <div class="mascot-card">
            <img src="/unnamed (2).png" alt="Hoppy" />
          </div>

          <div class="phone-frame">
            <img
              class="hero-screenshot"
              src="/hero-quiz-feedback.png"
              alt={`${copy.heroScreenshotTitle}: ${copy.heroScreenshotDescription}`}
            />
          </div>

          <div class="explanation-chip">
            <span aria-hidden="true">✓</span>
            {copy.explanationLabel}
          </div>
        </div>
      </div>
    </section>

    <section class="audience-selector" id="audiences" aria-labelledby="audience-selector-title">
      <div class="container">
        <h2 id="audience-selector-title" class="visually-hidden">{copy.conceptLabel}</h2>
        <div class="audience-grid">
          {audiences.map((audience, index) => (
            <a class="audience-card" href={`#${audience.id}`}>
              <span class:list={['audience-number', `audience-number-${index + 1}`]}>
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{audience.label}</h3>
              <p>{audience.summary}</p>
              <span class="audience-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {audiences.map((audience, index) => (
      <section
        class:list={[
          'audience-section',
          {
            'audience-section-alt': index % 2 === 1,
            'audience-section-parents': audience.id === 'parents',
          },
        ]}
        id={audience.id}
      >
        <div
          class:list={[
            'container',
            'audience-section-grid',
            {
              'audience-section-grid-wide': audience.id !== 'parents',
            },
          ]}
        >
          <div class="audience-copy">
            <p class="eyebrow">{audience.eyebrow}</p>
            <h2>{audience.title}</h2>
            <p class="audience-description">{audience.description}</p>

            <ul class="benefit-list">
              {audience.points.map((point) => <li>{point}</li>)}
            </ul>

            {audience.id === 'teachers' && (
              <a class="text-link" href={path('/guide')}>
                {copy.teacherGuideAction}
                <span aria-hidden="true">→</span>
              </a>
            )}
          </div>

          <div
            class:list={[
              'screenshot-panel',
              'screenshot-grid',
              {
                'screenshot-grid-featured': audience.id === 'parents',
                'screenshot-grid-equal': audience.id !== 'parents',
                'screenshot-grid-students': audience.id === 'students',
                'screenshot-grid-teachers': audience.id === 'teachers',
              },
            ]}
            aria-label={`${audience.label} screenshots`}
          >
            {audience.screenshots.map((screenshot, screenshotIndex) => (
              getScreenshotImage(audience.id, screenshotIndex) ? (
                <figure class="screenshot-image">
                  <a
                    class="screenshot-full-link"
                    href={getScreenshotImage(audience.id, screenshotIndex)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <img
                      src={getScreenshotImage(audience.id, screenshotIndex)}
                      alt={`${screenshot.title}: ${screenshot.description}`}
                      loading="lazy"
                    />
                  </a>
                  <figcaption>{screenshot.title}</figcaption>
                </figure>
              ) : (
                <div
                  class="screenshot-placeholder"
                  role="img"
                  aria-label={`${screenshot.title}: ${screenshot.description}`}
                >
                  <div>
                    <span class="placeholder-icon" aria-hidden="true">▧</span>
                    <strong>{screenshot.title}</strong>
                    <p>{screenshot.description}</p>
                  </div>
                </div>
              )
            ))}
          </div>
        </div>
      </section>
    ))}

    <section class="school-benefit">
      <div class="container school-benefit-content">
        <div class="school-benefit-icon" aria-hidden="true">🏫</div>
        <div>
          <p class="school-benefit-eyebrow">{schoolBenefit.eyebrow}</p>
          <h2>{schoolBenefit.title}</h2>
          <p class="school-benefit-description">{schoolBenefit.description}</p>
        </div>
      </div>
    </section>

    <section class="pricing-strip">
      <div class="container pricing-content">
        <div>
          <h2>{copy.pricingTitle}</h2>
          <p>{copy.pricingText}</p>
        </div>
        <a href={path('/pricing')} class="pricing-button">{copy.pricingButton}</a>
      </div>
    </section>

    <section class="final-cta">
      <div class="container cta-content">
        <img src="/hoppy-logo.jpeg" alt="Hoppy" loading="lazy" />
        <h2>{copy.ctaTitle}</h2>
        <p>{copy.ctaText}</p>
        <div class="store-buttons store-buttons-centered">
          <a class="store-button store-button-light" href="https://apps.apple.com/hk/app/hoppy-learn-10x-faster/id6754865277" target="_blank" rel="noopener noreferrer">
            <img src="/apple-logo.svg" alt="" class="store-brand-icon" aria-hidden="true" />
            <span><small>{copy.appSmall}</small><strong>{copy.appStore}</strong></span>
          </a>
          <a class="store-button store-button-light" href="https://play.google.com/store/apps/details?id=day.hoppy.app" target="_blank" rel="noopener noreferrer">
            <span class="store-mark play">▶</span>
            <span><small>{copy.playSmall}</small><strong>{copy.playStore}</strong></span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(html) {
    scroll-padding-top: 6rem;
  }

  main {
    overflow: hidden;
    color: var(--hoppy-navy);
    background: #fff;
  }

  .container {
    width: min(1160px, calc(100% - 3rem));
    margin-inline: auto;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero {
    position: relative;
    padding-block: clamp(4.5rem, 8vw, 7.5rem) 6rem;
    background:
      radial-gradient(circle at 88% 12%, rgba(63, 181, 219, 0.23), transparent 31%),
      linear-gradient(155deg, #fff 0%, #f2fbfe 72%);
  }

  .hero::after {
    position: absolute;
    right: -6rem;
    bottom: -8rem;
    width: 25rem;
    height: 25rem;
    border: 4.5rem solid rgba(255, 217, 102, 0.35);
    border-radius: 50%;
    content: '';
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(29rem, 0.98fr);
    gap: clamp(3rem, 6vw, 5rem);
    align-items: center;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 1.25rem;
    color: #258db4;
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 1.8rem;
    height: 3px;
    border-radius: 999px;
    background: var(--hoppy-blue);
    content: '';
  }

  .hero h1 {
    max-width: 42rem;
    margin: 0;
    color: var(--hoppy-navy);
    font-size: clamp(3.4rem, 6vw, 5.25rem);
    font-weight: 850;
    letter-spacing: -0.065em;
    line-height: 0.98;
  }

  .hero h1 span {
    color: #2797c0;
  }

  .hero-description {
    max-width: 39rem;
    margin: 1.65rem 0 0;
    color: #557084;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.45rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button:focus-visible,
  .audience-card:focus-visible,
  .text-link:focus-visible,
  .store-button:focus-visible {
    outline: 3px solid var(--hoppy-yellow);
    outline-offset: 4px;
  }

  .button-primary {
    color: #fff;
    background: var(--hoppy-navy);
    box-shadow: 0 0.75rem 1.6rem rgba(26, 49, 68, 0.18);
  }

  .button-primary:hover {
    background: #102737;
  }

  .button-secondary {
    color: var(--hoppy-navy);
    background: #fff;
    border-color: #d9e6ec;
  }

  .button-secondary:hover {
    border-color: var(--hoppy-blue);
  }

  .proof-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.5rem;
    margin: 1.8rem 0 0;
    padding: 0;
    color: #486477;
    list-style: none;
  }

  .proof-list li {
    font-size: 0.82rem;
    font-weight: 750;
  }

  .proof-list li::before {
    margin-right: 0.45rem;
    color: #2598c0;
    content: '✓';
  }

  .hero-visual {
    position: relative;
    min-height: 32rem;
  }

  .mascot-card {
    position: absolute;
    top: 0;
    right: 0;
    width: min(75%, 22rem);
    overflow: hidden;
    border: 0.65rem solid #fff;
    border-radius: 2rem;
    background: var(--hoppy-navy);
    box-shadow: 0 1.5rem 4rem rgba(26, 49, 68, 0.16);
    transform: rotate(2deg);
  }

  .mascot-card img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .phone-frame {
    position: absolute;
    right: 54%;
    bottom: 0;
    width: min(45%, 15rem);
    padding: 0.35rem;
    border: 0.45rem solid var(--hoppy-navy);
    border-radius: 2.25rem;
    background: #fff;
    box-shadow: 0 1.75rem 4.5rem rgba(26, 49, 68, 0.25);
    transform: translateX(50%) rotate(-4deg);
  }

  .phone-frame::before {
    content: none;
  }

  .hero-screenshot {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.55rem;
  }

  .explanation-chip {
    position: absolute;
    right: 0.5rem;
    bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.8rem 1rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 1rem 2.5rem rgba(26, 49, 68, 0.14);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .explanation-chip span {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 0.75rem;
    background: var(--hoppy-yellow);
  }

  .screenshot-placeholder {
    display: grid;
    min-height: 11rem;
    place-items: center;
    padding: 1.4rem;
    border: 2px dashed #8ecfe5;
    border-radius: 1.15rem;
    color: #3e697c;
    background:
      linear-gradient(135deg, rgba(63, 181, 219, 0.09), rgba(255, 255, 255, 0.92)),
      repeating-linear-gradient(
        -45deg,
        transparent 0 0.75rem,
        rgba(63, 181, 219, 0.05) 0.75rem 1.5rem
      );
    text-align: center;
  }

  .hero-screenshot-placeholder {
    min-height: 24rem;
    border-radius: 1.45rem;
  }

  .placeholder-icon {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    margin: 0 auto 0.8rem;
    place-items: center;
    border-radius: 0.75rem;
    color: #fff;
    background: var(--hoppy-blue);
    font-size: 1.25rem;
  }

  .screenshot-placeholder strong {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--hoppy-navy);
    font-size: 0.92rem;
  }

  .screenshot-placeholder p {
    max-width: 17rem;
    margin: 0 auto;
    color: #557084;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .audience-selector {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(5rem, 9vw, 7rem);
    background: #fff;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
    transform: translateY(-1.5rem);
  }

  .audience-card {
    position: relative;
    min-height: 13rem;
    padding: 1.7rem;
    overflow: hidden;
    border: 1px solid #dce8ee;
    border-radius: 1.5rem;
    color: var(--hoppy-navy);
    background: #fff;
    box-shadow: 0 1rem 2.6rem rgba(26, 49, 68, 0.08);
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .audience-card:hover {
    border-color: #9ed5e7;
    box-shadow: 0 1.3rem 3rem rgba(26, 49, 68, 0.13);
    transform: translateY(-4px);
  }

  .audience-number {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    border-radius: 0.9rem;
    background: #eaf8fd;
    font-size: 0.82rem;
    font-weight: 900;
  }

  .audience-number-2 {
    background: #fff4c4;
  }

  .audience-number-3 {
    background: #ebedff;
  }

  .audience-card h3 {
    margin: 1.3rem 0 0.55rem;
    font-size: 1.5rem;
    letter-spacing: -0.035em;
  }

  .audience-card p {
    margin: 0;
    color: #557084;
    font-size: 0.87rem;
    line-height: 1.6;
  }

  .audience-arrow {
    position: absolute;
    right: 1.5rem;
    bottom: 1.2rem;
    color: #258db4;
    font-size: 1.4rem;
  }

  .audience-section {
    padding-block: clamp(5.5rem, 10vw, 8rem);
    background: #f4f9fb;
  }

  .audience-section-alt {
    background: #fff;
  }

  .audience-section-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(31rem, 1.1fr);
    gap: clamp(3rem, 7vw, 6rem);
    align-items: center;
  }

  .audience-copy > .eyebrow {
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
  }

  .audience-copy h2 {
    max-width: 35rem;
    margin: 0;
    color: var(--hoppy-navy);
    font-size: clamp(1.95rem, 2.8vw, 2.6rem);
    font-weight: 850;
    letter-spacing: -0.06em;
    line-height: 1.05;
  }

  .audience-description {
    max-width: 35rem;
    margin: 1.4rem 0 0;
    color: #557084;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .benefit-list {
    display: grid;
    gap: 1rem;
    margin: 1.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .benefit-list li {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    color: var(--hoppy-navy);
    font-size: 0.94rem;
    font-weight: 750;
    line-height: 1.5;
  }

  .benefit-list li::before {
    display: grid;
    flex: 0 0 1.7rem;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: var(--hoppy-blue);
    content: '✓';
    font-size: 0.7rem;
  }

  .text-link {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    margin-top: 2rem;
    color: #167fa7;
    font-size: 0.92rem;
    font-weight: 850;
    text-decoration: none;
  }

  .text-link:hover {
    text-decoration: underline;
  }

  .screenshot-panel {
    padding: 1rem;
    border: 1px solid #dce8ee;
    border-radius: 1.75rem;
    background: #fff;
    box-shadow: 0 1.5rem 4rem rgba(26, 49, 68, 0.11);
  }

  .screenshot-grid {
    display: grid;
    gap: 1rem;
  }

  .screenshot-grid-featured {
    width: min(100%, 32rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    justify-self: center;
    padding: 0.8rem;
  }

  .screenshot-grid-featured > :first-child {
    grid-column: 1 / -1;
  }

  .screenshot-image {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid #d5e5ec;
    border-radius: 1.15rem;
    background: #f6fafc;
  }

  .screenshot-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .screenshot-grid-featured .screenshot-image:first-child img {
    height: 15rem;
    object-fit: contain;
    object-position: top center;
  }

  .screenshot-grid-featured .screenshot-image:not(:first-child) img {
    height: 20rem;
    object-fit: cover;
    object-position: top center;
  }

  .screenshot-image figcaption {
    padding: 0.65rem 0.75rem;
    border-top: 1px solid #e2edf2;
    color: var(--hoppy-navy);
    background: #fff;
    font-size: 0.78rem;
    font-weight: 800;
    text-align: center;
  }

  .screenshot-full-link {
    display: block;
  }

  .screenshot-grid-equal {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .screenshot-grid-equal .screenshot-placeholder {
    min-height: 23rem;
  }

  .screenshot-grid-equal .screenshot-image img {
    height: 23rem;
    object-fit: cover;
    object-position: top;
  }

  @media (min-width: 981px) {
    .audience-section-grid-wide {
      grid-template-columns: minmax(0, 0.55fr) minmax(43rem, 1.45fr);
      gap: 3rem;
    }

  }

  @media (min-width: 761px) {
    .audience-section-parents {
      padding-block: 2.5rem;
    }

    .screenshot-grid-students .screenshot-full-link,
    .screenshot-grid-teachers .screenshot-full-link {
      aspect-ratio: 1280 / 2760;
      overflow: hidden;
    }

    .screenshot-grid-students .screenshot-image img,
    .screenshot-grid-teachers .screenshot-image img {
      height: auto;
    }
  }

  .pricing-strip {
    padding-block: 3.2rem;
    background: var(--hoppy-navy);
    color: white;
  }

  .school-benefit {
    padding-block: clamp(4rem, 7vw, 6rem);
    background: #edf8fc;
  }

  .school-benefit-content {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid #cbe8f3;
    border-radius: 2rem;
    background: #fff;
    box-shadow: 0 1.25rem 3.5rem rgba(26, 49, 68, 0.09);
  }

  .school-benefit-icon {
    display: grid;
    width: clamp(4.5rem, 8vw, 6rem);
    aspect-ratio: 1;
    place-items: center;
    border-radius: 1.5rem;
    background: #dff4fb;
    font-size: clamp(2rem, 4vw, 3rem);
